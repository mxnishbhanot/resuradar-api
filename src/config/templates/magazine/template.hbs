<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{personal.firstName}} {{personal.lastName}} - Resume</title>
    <style>
        /* ============================================
           MAGAZINE-STYLE RESUME TEMPLATE
           Editorial Layout | Bold Headers | Asymmetric Design
           ============================================ */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Avenir Next", "Helvetica Neue", Arial, sans-serif;
            font-size: 10pt;
            line-height: 1.6;
            color: #1e1e1e;
            background: #ffffff;
            max-width: 8.5in;
            margin: 0 auto;
            padding: 0.45in 0.6in;
        }

        /* ============================================
           HEADER - EDITORIAL MASTHEAD
           ============================================ */

        .resume-header {
            margin-bottom: 36px;
            padding-bottom: 28px;
            border-bottom: 4px solid #1e1e1e;
            position: relative;
        }

        .name {
            font-size: 44pt;
            font-weight: 900;
            letter-spacing: -2px;
            color: #1e1e1e;
            margin-bottom: 4px;
            line-height: 0.95;
            text-transform: uppercase;
        }

        .headline {
            font-size: 13pt;
            font-weight: 300;
            color: #e63946;
            margin-bottom: 18px;
            letter-spacing: 0.5px;
            font-style: italic;
        }

        .contact-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 10px 20px;
            font-size: 8.5pt;
            color: #4a4a4a;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .contact-item::before {
            content: '■';
            color: #e63946;
            font-size: 6pt;
        }

        .contact-info a {
            color: #1e1e1e;
            text-decoration: none;
            font-weight: 600;
        }

        .contact-info a:hover {
            color: #e63946;
        }

        /* ============================================
           SUMMARY - PULL QUOTE STYLE
           ============================================ */

        .summary {
            margin-bottom: 32px;
            padding: 20px 24px 20px 48px;
            background: #1e1e1e;
            color: #ffffff;
            line-height: 1.7;
            font-size: 11pt;
            position: relative;
            font-weight: 400;
        }

        .summary::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 20px;
            width: 4px;
            height: calc(100% - 40px);
            background: #e63946;
        }

        /* ============================================
           SECTION HEADERS - BOLD EDITORIAL
           ============================================ */

        .section {
            margin-bottom: 32px;
        }

        .section-title {
            font-size: 22pt;
            font-weight: 900;
            letter-spacing: -1px;
            color: #1e1e1e;
            margin-bottom: 18px;
            text-transform: uppercase;
            position: relative;
            padding-left: 16px;
        }

        .section-title::before {
            content: '';
            position: absolute;
            left: 0;
            top: 4px;
            width: 6px;
            height: calc(100% - 8px);
            background: #e63946;
        }

        /* ============================================
           ENTRY BLOCKS - ASYMMETRIC LAYOUT
           ============================================ -->

        .entry {
            margin-bottom: 24px;
            page-break-inside: avoid;
            padding-left: 16px;
            border-left: 2px solid #f0f0f0;
        }

        .entry:hover {
            border-left-color: #e63946;
        }

        .entry:last-child {
            margin-bottom: 0;
        }

        .entry-header {
            margin-bottom: 6px;
        }

        .entry-title-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 4px;
        }

        .entry-title {
            font-size: 12pt;
            font-weight: 700;
            color: #1e1e1e;
            letter-spacing: -0.3px;
        }

        .entry-date {
            font-size: 8pt;
            color: #e63946;
            white-space: nowrap;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .entry-subtitle {
            font-size: 10pt;
            color: #4a4a4a;
            margin-bottom: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            font-size: 9pt;
        }

        .entry-location {
            font-size: 9pt;
            color: #6a6a6a;
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
        }

        /* ============================================
           BULLET POINTS - EDITORIAL STYLE
           ============================================ */

        .bullets {
            list-style: none;
            margin-top: 10px;
        }

        .bullets li {
            position: relative;
            padding-left: 20px;
            margin-bottom: 8px;
            line-height: 1.65;
        }

        .bullets li:before {
            content: '▶';
            position: absolute;
            left: 0;
            color: #e63946;
            font-size: 7pt;
            top: 4px;
        }

        /* ============================================
           SKILLS - MAGAZINE GRID
           ============================================ */

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }

        .skill-category {
            background: #fafafa;
            padding: 16px 18px;
            border-left: 4px solid #e63946;
        }

        .skill-category:nth-child(even) {
            background: #1e1e1e;
        }

        .skill-category:nth-child(even) .skill-category-name {
            color: #ffffff;
        }

        .skill-category:nth-child(even) .skill-list {
            color: #cccccc;
        }

        .skill-category-name {
            font-size: 9pt;
            font-weight: 700;
            color: #1e1e1e;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .skill-list {
            font-size: 9pt;
            color: #4a4a4a;
            line-height: 1.7;
            font-weight: 500;
        }

        /* ============================================
           PROJECTS - FEATURED STYLE
           ============================================ */

        .project-header {
            margin-bottom: 6px;
        }

        .project-title-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 4px;
        }

        .project-title {
            font-size: 12pt;
            font-weight: 700;
            color: #1e1e1e;
        }

        .project-link {
            font-size: 8pt;
            color: #ffffff;
            background: #e63946;
            padding: 4px 10px;
            text-decoration: none;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .project-link:hover {
            background: #1e1e1e;
        }

        .project-meta {
            font-size: 9pt;
            color: #4a4a4a;
            margin-bottom: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .tech-stack {
            font-size: 8.5pt;
            color: #6a6a6a;
            margin-top: 10px;
            padding: 8px 12px;
            background: #f5f5f5;
            border-left: 3px solid #1e1e1e;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        /* ============================================
           EDUCATION
           ============================================ */

        .education-details {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }

        .gpa {
            font-size: 8pt;
            color: #e63946;
            white-space: nowrap;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* ============================================
           DECORATIVE ELEMENTS
           ============================================ */

        .section-number {
            font-size: 72pt;
            font-weight: 900;
            color: #f0f0f0;
            position: absolute;
            right: 20px;
            top: -20px;
            z-index: -1;
        }

        /* ============================================
           PRINT OPTIMIZATION
           ============================================ */

        @media print {
            body {
                padding: 0.35in 0.5in;
            }

            .section {
                page-break-inside: avoid;
            }

            .entry {
                page-break-inside: avoid;
            }

            .summary {
                background: #f5f5f5;
                color: #1e1e1e;
            }

            .skill-category:nth-child(even) {
                background: #f0f0f0;
            }

            .skill-category:nth-child(even) .skill-category-name,
            .skill-category:nth-child(even) .skill-list {
                color: #1e1e1e;
            }
        }
    </style>
</head>
<body>
    <!-- ============================================
         HEADER - MASTHEAD
         ============================================ -->
    <header class="resume-header">
        <h1 class="name">{{personal.firstName}} {{personal.lastName}}</h1>
        {{#if personal.headline}}
        <p class="headline">{{personal.headline}}</p>
        {{/if}}
        <div class="contact-info">
            {{#if personal.email}}
            <div class="contact-item"><a href="mailto:{{personal.email}}">{{personal.email}}</a></div>
            {{/if}}
            {{#if personal.phone}}
            <div class="contact-item">{{personal.phone}}</div>
            {{/if}}
            {{#if personal.location}}
            <div class="contact-item">{{personal.location}}</div>
            {{/if}}
            {{#if personal.linkedin}}
            <div class="contact-item"><a href="{{personal.linkedin}}" target="_blank">LinkedIn</a></div>
            {{/if}}
            {{#if personal.github}}
            <div class="contact-item"><a href="{{personal.github}}" target="_blank">GitHub</a></div>
            {{/if}}
        </div>
    </header>

    <!-- ============================================
         PROFILE / SUMMARY
         ============================================ -->
    {{#if personal.summary}}
    <section class="summary">
        {{personal.summary}}
    </section>
    {{/if}}

    <!-- ============================================
         EXPERIENCE
         ============================================ -->
    {{#if experiences}}
    <section class="section">
        <h2 class="section-title">Experience</h2>
        {{#each experiences}}
        <div class="entry">
            <div class="entry-header">
                <div class="entry-title-row">
                    <h3 class="entry-title">{{this.title}}</h3>
                    <span class="entry-date">
                        {{this.startDate}}{{#if this.isCurrent}}—Now{{else}}{{#if this.endDate}}—{{this.endDate}}{{/if}}{{/if}}
                    </span>
                </div>
                <div class="entry-subtitle">
                    {{#if this.company}}{{this.company}}{{/if}}
                    {{#if this.location}}<span class="entry-location"> • {{this.location}}</span>{{/if}}
                </div>
            </div>
            {{#if this.bullets}}
            <ul class="bullets">
                {{#each this.bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
    </section>
    {{/if}}

    <!-- ============================================
         EDUCATION
         ============================================ -->
    {{#if educations}}
    <section class="section">
        <h2 class="section-title">Education</h2>
        {{#each educations}}
        <div class="entry">
            <div class="entry-header">
                <div class="entry-title-row">
                    <h3 class="entry-title">{{this.institution}}</h3>
                    <span class="entry-date">
                        {{this.startDate}}{{#if this.isCurrent}}—Now{{else}}{{#if this.endDate}}—{{this.endDate}}{{/if}}{{/if}}
                    </span>
                </div>
                <div class="education-details">
                    <div class="entry-subtitle">
                        {{this.degree}} • {{this.major}}
                    </div>
                    {{#if this.gpa}}
                    <span class="gpa">GPA {{this.gpa}}</span>
                    {{/if}}
                </div>
            </div>
            {{#if this.bullets}}
            <ul class="bullets">
                {{#each this.bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
    </section>
    {{/if}}

    <!-- ============================================
         PROJECTS
         ============================================ -->
    {{#if projects}}
    <section class="section">
        <h2 class="section-title">Projects</h2>
        {{#each projects}}
        <div class="entry">
            <div class="project-header">
                <div class="project-title-row">
                    <h3 class="project-title">{{this.title}}</h3>
                    {{#if this.link}}
                    <a href="{{this.link}}" class="project-link" target="_blank">View</a>
                    {{/if}}
                </div>
                <div class="project-meta">
                    {{#if this.role}}{{this.role}}{{/if}}
                    {{#if this.startDate}}
                    {{#if this.role}} • {{/if}}{{this.startDate}}{{#if this.isCurrent}}—Now{{else}}{{#if this.endDate}}—{{this.endDate}}{{/if}}{{/if}}
                    {{/if}}
                </div>
            </div>
            {{#if this.bullets}}
            <ul class="bullets">
                {{#each this.bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
            {{#if this.techStack}}
            <div class="tech-stack">
                {{#each this.techStack}}{{this}}{{#unless @last}} • {{/unless}}{{/each}}
            </div>
            {{/if}}
        </div>
        {{/each}}
    </section>
    {{/if}}

    <!-- ============================================
         SKILLS
         ============================================ -->
    {{#if skills}}
    <section class="section">
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
            {{#each skills}}
            <div class="skill-category">
                <div class="skill-category-name">{{this.name}}</div>
                <div class="skill-list">
                    {{#each this.skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
                </div>
            </div>
            {{/each}}
        </div>
    </section>
    {{/if}}

</body>
</html>