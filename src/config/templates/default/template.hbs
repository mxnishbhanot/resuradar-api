<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <style id="resume-styles">
    /* ========== CORE ========== */
    body {
      font-family: "Times New Roman", serif;
      font-size: 12px;
      margin: 22px;
      color: #000;
    }

    .resume { width: 100%; }

    .no-break { page-break-inside: avoid; }


    /* ========== HEADER ========== */
    .header { text-align: center; margin-bottom: 10px; }

    .name {
      font-size: 22px;
      margin: 0;
      font-weight: bold;
    }

    .headline { font-size: 13px; margin: 2px 0; }

    .contact {
      font-size: 11px;
      margin-top: 4px;
    }
    .contact span::after { content: " | "; }
    .contact span:last-child::after { content: ""; }


    /* ========== SECTION ========== */
    .section { margin-top: 12px; }

    .section-title {
      font-size: 14px;
      font-weight: bold;
      border-bottom: 1px solid #000;
      padding-bottom: 2px;
      margin-bottom: 6px;
    }


    /* ========== PARAGRAPH TEXT ========== */
    .text {
      line-height: 1.3;
      margin: 0;
    }

    .small { font-size: 11px; }


    /* ========== ITEMS (Experience, Education, Projects) ========== */
    .item { margin-bottom: 6px; }

    .item-row {
      display: flex;
      justify-content: space-between;
    }

    .item-title {
      font-size: 13px;
      margin: 0;
      font-weight: bold;
    }

    .company {
      font-size: 12px;
      margin: 0;
    }

    .date { font-size: 11px; white-space: nowrap; }


    /* ========== BULLETS ========== */
    .bullets {
      margin: 2px 0 0 18px;
      padding: 0;
    }

    .bullets li {
      line-height: 1.3;
      margin-bottom: 2px;
    }


    /* ========== SKILLS (New Layout for Categories) ========== */
    .skill-category {
      margin-bottom: 4px;
    }
    .skill-category-name {
      font-weight: bold;
      font-size: 12px;
      margin-bottom: 2px;
      display: block;
    }
    .skill-list {
      list-style-type: none;
      padding-left: 0;
      margin: 0;
      display: inline;
      font-size: 11px;
    }
    .skill-list li {
      display: inline;
    }
    .skill-list li:not(:last-child)::after {
      content: " | ";
      font-weight: normal;
    }


    /* ========== PROJECT LINKS ========== */
    .link {
      font-size: 12px;
      margin: 2px 0;
      word-break: break-all;
    }
    
    .proj-role {
      font-size: 12px;
      margin: 0 0 2px 0;
    }
    
    .proj-tech-stack {
      font-size: 11px;
      margin: 2px 0 0 0;
    }

  </style>
</head>

<body>
<div class="resume">

  <!-- ================= HEADER ================= -->
  <header class="header no-break">
    <h1 class="name">{{personal.firstName}} {{personal.lastName}}</h1>

    {{#if personal.headline}}
    <p class="headline">{{personal.headline}}</p>
    {{/if}}

    <div class="contact">
      {{#if personal.email}} <span>{{personal.email}}</span> {{/if}}
      {{#if personal.phone}} <span>{{personal.phone}}</span> {{/if}}
      {{#if personal.location}} <span>{{personal.location}}</span> {{/if}}
      {{#if personal.linkedin}} <span>LinkedIn</span> {{/if}}
      {{#if personal.github}} <span>GitHub</span> {{/if}}
    </div>
  </header>


  <!-- ================= SUMMARY ================= -->
  {{#if personal.summary}}
  <section class="section">
    <h2 class="section-title">Professional Summary</h2>
    <p class="text">{{personal.summary}}</p>
  </section>
  {{/if}}


  <!-- ================= EXPERIENCE ================= -->
  {{#if experiences.length}}
  <section class="section">
    <h2 class="section-title">Professional Experience</h2>

    {{#each experiences}}
    <div class="item no-break">

      <div class="item-row">
        <div>
          <h3 class="item-title">{{title}}</h3>
          {{#if company}}
          <p class="company">{{company}}</p>
          {{/if}}
        </div>

        <div class="date">
          {{startDate}}
          –
          {{#if isCurrent}}Present{{else}}{{endDate}}{{/if}}
        </div>
      </div>

      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

    </div>
    {{/each}}
  </section>
  {{/if}}



  <!-- ================= EDUCATION ================= -->
  {{#if educations.length}}
  <section class="section">
    <h2 class="section-title">Education</h2>

    {{#each educations}}
    <div class="item no-break">

      <div class="item-row">
        <div>
          <!-- FIX: Use major field and institution field -->
          <h3 class="item-title">
            {{degree}}
            {{#if major}}
              in {{major}}
            {{/if}}
          </h3>
          <p class="company">{{institution}}</p>
          {{#if gpa}}<p class="small">GPA: {{gpa}}</p>{{/if}}
        </div>

        <div class="date">
          {{startDate}}
          –
          {{#if isCurrent}}Present{{else}}{{endDate}}{{/if}}
        </div>
      </div>

      <!-- FIX: Use bullets array -->
      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

    </div>
    {{/each}}
  </section>
  {{/if}}



  <!-- ================= SKILLS (Updated for SkillCategory structure) ================= -->
  {{#if skills.length}}
  <section class="section">
    <h2 class="section-title">Skills</h2>

    {{#each skills}}
    <div class="skill-category no-break">
        <span class="skill-category-name">{{name}}:</span>
        <ul class="skill-list">
        {{#each skills}}
            <li>{{this}}</li>
        {{/each}}
        </ul>
    </div>
    {{/each}}
  </section>
  {{/if}}



  <!-- ================= PROJECTS ================= -->
  {{#if projects.length}}
  <section class="section">
    <h2 class="section-title">Projects</h2>

    {{#each projects}}
    <div class="item no-break">

      <div class="item-row">
        <div>
          <h3 class="item-title">{{title}}</h3>
          {{#if role}}
          <p class="proj-role">{{role}}</p>
          {{/if}}
        </div>
        
        <div class="date">
          {{startDate}}
          –
          {{#if isCurrent}}Present{{else}}{{endDate}}{{/if}}
        </div>
      </div>
      
      {{#if link}}
      <p class="link">{{link}}</p>
      {{/if}}

      <!-- FIX: Use bullets array -->
      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

      <!-- FIX: Use techStack array -->
      {{#if techStack.length}}
      <p class="proj-tech-stack small">
        <strong>Technologies:</strong>
        {{#each techStack}}
          {{this}}{{#unless @last}}, {{/unless}}
        {{/each}}
      </p>
      {{/if}}

    </div>
    {{/each}}
  </section>
  {{/if}}

</div>
</body>

</html>