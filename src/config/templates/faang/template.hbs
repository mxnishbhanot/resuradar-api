<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    @page { margin: 0; size: A4; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
      font-size: 9.5pt;
      line-height: 1.42;
      color: #111827;
      background: #fff;
      padding: 9mm 12mm;
      max-width: 210mm;
      margin: 0 auto;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .bar {
      height: 4pt;
      background: #111827;
      margin: -9mm -12mm 10mm -12mm;
      width: calc(100% + 24mm);
    }
    .header { margin-bottom: 12pt; }
    .name {
      font-size: 20pt;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #111827;
    }
    .headline { font-size: 10pt; font-weight: 500; color: #4b5563; margin-top: 3pt; }
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 4pt 12pt;
      margin-top: 8pt;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 8.25pt;
      color: #6b7280;
    }
    .section { margin-bottom: 12pt; page-break-inside: avoid; }
    .section-title {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 8pt;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #fff;
      background: #111827;
      display: inline-block;
      padding: 3pt 8pt;
      margin-bottom: 8pt;
    }
    .summary { font-size: 9.5pt; color: #374151; line-height: 1.5; }
    .entry {
      margin-bottom: 10pt;
      padding-left: 10pt;
      border-left: 2pt solid #e5e7eb;
      page-break-inside: avoid;
    }
    .row { display: flex; justify-content: space-between; gap: 12pt; align-items: flex-start; }
    .role { font-size: 10.25pt; font-weight: 700; color: #111827; }
    .co { font-size: 9.25pt; font-weight: 600; color: #374151; margin-top: 1pt; }
    .sub { font-size: 8.5pt; color: #6b7280; margin-top: 2pt; }
    .dates {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 8pt;
      font-weight: 500;
      color: #111827;
      background: #f3f4f6;
      padding: 3pt 6pt;
      white-space: nowrap;
      flex-shrink: 0;
    }
    ul.bullets { margin: 5pt 0 0 12pt; padding: 0; }
    ul.bullets li { margin-bottom: 3pt; font-size: 9pt; color: #374151; line-height: 1.45; }
    .skills {
      display: grid;
      grid-template-columns: 140pt 1fr;
      gap: 6pt 10pt;
      font-size: 9pt;
    }
    .skills .k {
      font-weight: 700;
      color: #111827;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 8pt;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .skills .v { color: #4b5563; }
    .tech { font-family: 'IBM Plex Mono', monospace; font-size: 7.75pt; color: #6b7280; margin-top: 4pt; }
    a { color: #111827; font-weight: 600; }
  </style>
</head>
<body>
  <div class="bar"></div>

  <header class="header">
    <div class="name">{{personal.firstName}} {{personal.lastName}}</div>
    {{#if personal.headline}}<div class="headline">{{personal.headline}}</div>{{/if}}
    <div class="meta">
      {{#if personal.email}}<span>{{personal.email}}</span>{{/if}}
      {{#if personal.phone}}<span>{{personal.phone}}</span>{{/if}}
      {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
    </div>
  </header>

  {{#if personal.summary}}
  <section class="section">
    <div class="section-title">Summary</div>
    <div class="summary">{{personal.summary}}</div>
  </section>
  {{/if}}

  {{#if experiences.length}}
  <section class="section">
    <div class="section-title">Experience</div>
    {{#each experiences}}
    <div class="entry">
      <div class="row">
        <div>
          <div class="role">{{title}}</div>
          {{#if company}}<div class="co">{{company}}</div>{{/if}}
          {{#if role}}<div class="sub">{{role}}</div>{{/if}}
        </div>
        <div class="dates">
          {{#if startDate}}{{formatDate startDate}}{{/if}}
          {{#if isCurrent}} — now{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
        </div>
      </div>
      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}<li>{{this}}</li>{{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if educations.length}}
  <section class="section">
    <div class="section-title">Education</div>
    {{#each educations}}
    <div class="entry">
      <div class="row">
        <div>
          <div class="role">{{institution}}</div>
          <div class="co">{{degree}}{{#if major}} · {{major}}{{/if}}{{#if gpa}} · GPA {{gpa}}{{/if}}</div>
        </div>
        <div class="dates">
          {{#if startDate}}{{formatDate startDate}}{{/if}}
          {{#if isCurrent}} — now{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
        </div>
      </div>
      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}<li>{{this}}</li>{{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if projects.length}}
  <section class="section">
    <div class="section-title">Projects</div>
    {{#each projects}}
    <div class="entry">
      <div class="row">
        <div>
          <div class="role">{{title}}{{#if link}} · <a href="{{link}}">link</a>{{/if}}</div>
          {{#if role}}<div class="sub">{{role}}</div>{{/if}}
        </div>
        <div class="dates">
          {{#if startDate}}{{formatDate startDate}}{{/if}}
          {{#if isCurrent}} — now{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
        </div>
      </div>
      {{#if techStack.length}}
      <div class="tech">{{#each techStack}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</div>
      {{/if}}
      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}<li>{{this}}</li>{{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if skills.length}}
  <section class="section">
    <div class="section-title">Skills</div>
    <div class="skills">
      {{#each skills}}
      <div class="k">{{name}}</div>
      <div class="v">{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
      {{/each}}
    </div>
  </section>
  {{/if}}

</body>
</html>
