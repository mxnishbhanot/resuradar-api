<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <style>
    @page { margin: 0; size: A4; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-size: 9.5pt;
      line-height: calc(1.42 * var(--rr-line-height-mul, 1));
      color: var(--rr-ink);
      background: var(--rr-bg);
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .bar {
      height: 2pt;
      background: var(--rr-border);
      margin: 0 0 10pt 0;
      width: 100%;
    }
    .header { margin-bottom: 12pt; }
    .name {
      font-size: 20pt;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--rr-heading);
    }
    .headline { font-size: 10pt; font-weight: 500; color: var(--rr-muted); margin-top: 3pt; }
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 4pt 12pt;
      margin-top: 8pt;
      font-size: 8.25pt;
      color: var(--rr-muted);
    }
    .section { margin-bottom: calc(12pt * var(--rr-section-gap-mul, 1)); page-break-inside: avoid; }
    .section-title {
      font-size: 8pt;
      font-weight: var(--rr-heading-weight, 700);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--rr-heading);
      background: var(--rr-soft);
      border: 0.5pt solid var(--rr-border);
      display: inline-block;
      padding: 3pt 8pt;
      margin-bottom: 8pt;
    }
    .summary { font-size: 9.5pt; color: var(--rr-ink); line-height: 1.5; }
    .entry {
      margin-bottom: 10pt;
      padding-left: 10pt;
      border-left: 2pt solid var(--rr-border);
      page-break-inside: avoid;
    }
    .row { display: flex; justify-content: space-between; gap: 12pt; align-items: flex-start; }
    .role { font-size: 10.25pt; font-weight: 700; color: var(--rr-heading); }
    .co { font-size: 9.25pt; font-weight: 600; color: var(--rr-ink); margin-top: 1pt; }
    .sub { font-size: 8.5pt; color: var(--rr-muted); margin-top: 2pt; }
    .dates {
      font-size: 8pt;
      font-weight: 600;
      color: var(--rr-muted);
      background: var(--rr-soft);
      border: 0.5pt solid var(--rr-border);
      padding: 3pt 6pt;
      white-space: nowrap;
      flex-shrink: 0;
    }
    ul.bullets { margin: 5pt 0 0 12pt; padding: 0; }
    ul.bullets li { margin-bottom: 3pt; font-size: 9pt; color: var(--rr-ink); line-height: 1.45; }
    .skills {
      display: grid;
      grid-template-columns: 140pt 1fr;
      gap: 6pt 10pt;
      font-size: 9pt;
    }
    .skills .k {
      font-weight: 700;
      color: var(--rr-heading);
      font-size: 8pt;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .skills .v { color: var(--rr-muted); }
    .tech { font-size: 7.75pt; color: var(--rr-muted); margin-top: 4pt; }
  </style>
</head>
<body class="rr-resume">
  <div class="bar"></div>

  <header class="header">
    <div class="name">{{personal.firstName}} {{personal.lastName}}</div>
    {{#if personal.headline}}<div class="headline">{{personal.headline}}</div>{{/if}}
    <div class="meta">
      {{#if personal.email}}<span>{{personal.email}}</span>{{/if}}
      {{#if personal.phone}}<span>{{personal.phone}}</span>{{/if}}
      {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
      {{#if personal.linkedin}}<span><a href="{{hrefUrl personal.linkedin}}">LinkedIn</a></span>{{/if}}
      {{#if personal.portfolioUrl}}<span><a href="{{hrefUrl personal.portfolioUrl}}">Portfolio</a></span>{{/if}}
      {{#if personal.github}}<span><a href="{{hrefUrl personal.github}}">GitHub</a></span>{{/if}}
    </div>
  </header>

  {{#each sectionOrder}}
    {{#if (eq this "summary")}}
      {{#if @root.personal.summary}}
      <section class="section">
        <div class="section-title">Summary</div>
        <div class="summary" data-rr-field="personal.summary">{{{fmt @root.personal.summary}}}</div>
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "experience")}}
      {{#if @root.experiences.length}}
      <section class="section" data-rr-field="section.experience">
        <div class="section-title">Experience</div>
        {{#each @root.experiences}}
        <div class="entry">
          <div class="row">
            <div>
              <div class="role">{{title}}</div>
              {{#if company}}<div class="co">{{company}}</div>{{/if}}
              {{#if role}}<div class="sub">{{role}}</div>{{/if}}
            </div>
            <div class="dates">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} — now{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
            </div>
          </div>
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "education")}}
      {{#if @root.educations.length}}
      <section class="section" data-rr-field="section.education">
        <div class="section-title">Education</div>
        {{#each @root.educations}}
        <div class="entry">
          <div class="row">
            <div>
              <div class="role">{{institution}}</div>
              <div class="co">{{degree}}{{#if major}} · {{major}}{{/if}}{{#if gpa}} · GPA {{gpa}}{{/if}}</div>
            </div>
            <div class="dates">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} — now{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
            </div>
          </div>
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "projects")}}
      {{#if @root.projects.length}}
      <section class="section" data-rr-field="section.projects">
        <div class="section-title">Projects</div>
        {{#each @root.projects}}
        <div class="entry">
          <div class="row">
            <div>
              <div class="role">{{title}}{{#if link}} · <a href="{{link}}">link</a>{{/if}}</div>
              {{#if role}}<div class="sub">{{role}}</div>{{/if}}
            </div>
            <div class="dates">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} — now{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
            </div>
          </div>
          {{#if techStack.length}}
          <div class="tech">{{#each techStack}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</div>
          {{/if}}
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "skills")}}
      {{#if @root.skills.length}}
      <section class="section" data-rr-field="section.skills">
        <div class="section-title">Skills</div>
        <div class="skills">
          {{#each @root.skills}}
          <div class="k">{{{fmt name}}}</div>
          <div class="v">{{#each skills}}{{{fmt this}}}{{#unless @last}}, {{/unless}}{{/each}}</div>
          {{/each}}
        </div>
      </section>
      {{/if}}
    {{/if}}
  {{/each}}

</body>
</html>
