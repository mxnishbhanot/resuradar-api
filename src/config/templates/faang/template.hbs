<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{personal.firstName}} {{personal.lastName}} - Resume</title>
    <style>
        /* ============================================
           APPLE-LIKE CLEAN RESUME TEMPLATE
           ATS-Optimized | Professional | Minimal
           ============================================ */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 10.5pt;
            line-height: 1.5;
            color: #1d1d1f;
            background: #ffffff;
            max-width: 8.5in;
            margin: 0 auto;
            padding: 0.5in 0.6in;
        }

        /* ============================================
           TYPOGRAPHY HIERARCHY
           ============================================ */

        .resume-header {
            text-align: center;
            margin-bottom: 32px;
            padding-bottom: 24px;
            border-bottom: 1px solid #d2d2d7;
        }

        .name {
            font-size: 32pt;
            font-weight: 600;
            letter-spacing: -0.5px;
            color: #1d1d1f;
            margin-bottom: 6px;
        }

        .headline {
            font-size: 12pt;
            font-weight: 400;
            color: #6e6e73;
            margin-bottom: 12px;
        }

        .contact-info {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 9.5pt;
            color: #6e6e73;
        }

        .contact-info a {
            color: #0071e3;
            text-decoration: none;
        }

        .contact-info a:hover {
            text-decoration: underline;
        }

        .contact-separator {
            color: #d2d2d7;
        }

        /* ============================================
           SUMMARY SECTION
           ============================================ */

        .summary {
            margin-bottom: 28px;
            line-height: 1.6;
            color: #1d1d1f;
            text-align: left;
        }

        /* ============================================
           SECTION STYLING
           ============================================ */

        .section {
            margin-bottom: 28px;
        }

        .section-title {
            font-size: 14pt;
            font-weight: 600;
            letter-spacing: -0.3px;
            color: #1d1d1f;
            margin-bottom: 16px;
            text-transform: uppercase;
            font-size: 11pt;
            letter-spacing: 0.5px;
        }

        /* ============================================
           EXPERIENCE & EDUCATION BLOCKS
           ============================================ */

        .entry {
            margin-bottom: 20px;
            page-break-inside: avoid;
        }

        .entry:last-child {
            margin-bottom: 0;
        }

        .entry-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 4px;
        }

        .entry-title {
            font-size: 11pt;
            font-weight: 600;
            color: #1d1d1f;
        }

        .entry-date {
            font-size: 9.5pt;
            color: #6e6e73;
            white-space: nowrap;
        }

        .entry-subtitle {
            font-size: 10pt;
            color: #6e6e73;
            margin-bottom: 8px;
        }

        .entry-location {
            font-size: 9.5pt;
            color: #86868b;
            font-style: italic;
        }

        /* ============================================
           BULLET POINTS
           ============================================ */

        .bullets {
            list-style: none;
            margin-top: 8px;
        }

        .bullets li {
            position: relative;
            padding-left: 18px;
            margin-bottom: 6px;
            line-height: 1.5;
        }

        .bullets li:before {
            content: "•";
            position: absolute;
            left: 0;
            color: #6e6e73;
            font-weight: 600;
        }

        /* ============================================
           SKILLS SECTION
           ============================================ */

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }

        .skill-category {
            margin-bottom: 12px;
        }

        .skill-category-name {
            font-size: 10pt;
            font-weight: 600;
            color: #1d1d1f;
            margin-bottom: 6px;
        }

        .skill-list {
            font-size: 9.5pt;
            color: #6e6e73;
            line-height: 1.6;
        }

        /* ============================================
           PROJECTS SECTION
           ============================================ */

        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 4px;
        }

        .project-title {
            font-size: 11pt;
            font-weight: 600;
            color: #1d1d1f;
        }

        .project-link {
            font-size: 9.5pt;
            color: #0071e3;
            text-decoration: none;
        }

        .project-link:hover {
            text-decoration: underline;
        }

        .project-meta {
            font-size: 9.5pt;
            color: #6e6e73;
            margin-bottom: 6px;
        }

        .tech-stack {
            font-size: 9.5pt;
            color: #86868b;
            margin-top: 6px;
            font-style: italic;
        }

        /* ============================================
           EDUCATION GPA
           ============================================ */

        .education-details {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }

        .gpa {
            font-size: 9.5pt;
            color: #6e6e73;
            white-space: nowrap;
        }

        /* ============================================
           PRINT OPTIMIZATION
           ============================================ */

        @media print {
            body {
                padding: 0.4in 0.5in;
            }

            .section {
                page-break-inside: avoid;
            }

            .entry {
                page-break-inside: avoid;
            }
        }

        /* ============================================
           UTILITY CLASSES
           ============================================ */

        .text-muted {
            color: #6e6e73;
        }

        .text-light {
            color: #86868b;
        }

        .mb-small {
            margin-bottom: 12px;
        }

        .mb-medium {
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <!-- ============================================
         HEADER SECTION
         ============================================ -->
    <header class="resume-header">
        <h1 class="name">{{personal.firstName}} {{personal.lastName}}</h1>
        {{#if personal.headline}}
        <p class="headline">{{personal.headline}}</p>
        {{/if}}
        <div class="contact-info">
            {{#if personal.email}}
            <span><a href="mailto:{{personal.email}}">{{personal.email}}</a></span>
            {{/if}}
            {{#if personal.phone}}
            <span class="contact-separator">•</span>
            <span>{{personal.phone}}</span>
            {{/if}}
            {{#if personal.location}}
            <span class="contact-separator">•</span>
            <span>{{personal.location}}</span>
            {{/if}}
            {{#if personal.linkedin}}
            <span class="contact-separator">•</span>
            <span><a href="{{personal.linkedin}}" target="_blank">LinkedIn</a></span>
            {{/if}}
            {{#if personal.github}}
            <span class="contact-separator">•</span>
            <span><a href="{{personal.github}}" target="_blank">GitHub</a></span>
            {{/if}}
        </div>
    </header>

    <!-- ============================================
         SUMMARY SECTION
         ============================================ -->
    {{#if personal.summary}}
    <section class="summary">
        {{personal.summary}}
    </section>
    {{/if}}

    <!-- ============================================
         EXPERIENCE SECTION
         ============================================ -->
    {{#if experiences}}
    <section class="section">
        <h2 class="section-title">Experience</h2>
        {{#each experiences}}
        <div class="entry">
            <div class="entry-header">
                <h3 class="entry-title">{{this.title}}</h3>
                <span class="entry-date">
                    {{this.startDate}}{{#if this.isCurrent}} - Present{{else}}{{#if this.endDate}} - {{this.endDate}}{{/if}}{{/if}}
                </span>
            </div>
            <div class="entry-subtitle">
                {{#if this.company}}{{this.company}}{{/if}}
                {{#if this.location}}<span class="entry-location"> • {{this.location}}</span>{{/if}}
            </div>
            {{#if this.bullets}}
            <ul class="bullets">
                {{#each this.bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
    </section>
    {{/if}}

    <!-- ============================================
         EDUCATION SECTION
         ============================================ -->
    {{#if educations}}
    <section class="section">
        <h2 class="section-title">Education</h2>
        {{#each educations}}
        <div class="entry">
            <div class="entry-header">
                <h3 class="entry-title">{{this.institution}}</h3>
                <span class="entry-date">
                    {{this.startDate}}{{#if this.isCurrent}} - Present{{else}}{{#if this.endDate}} - {{this.endDate}}{{/if}}{{/if}}
                </span>
            </div>
            <div class="education-details">
                <div class="entry-subtitle">
                    {{this.degree}} in {{this.major}}
                </div>
                {{#if this.gpa}}
                <span class="gpa">GPA: {{this.gpa}}</span>
                {{/if}}
            </div>
            {{#if this.bullets}}
            <ul class="bullets">
                {{#each this.bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
    </section>
    {{/if}}

    <!-- ============================================
         PROJECTS SECTION
         ============================================ -->
    {{#if projects}}
    <section class="section">
        <h2 class="section-title">Projects</h2>
        {{#each projects}}
        <div class="entry">
            <div class="project-header">
                <h3 class="project-title">{{this.title}}</h3>
                {{#if this.link}}
                <a href="{{this.link}}" class="project-link" target="_blank">View Project →</a>
                {{/if}}
            </div>
            <div class="project-meta">
                {{#if this.role}}{{this.role}}{{/if}}
                {{#if this.startDate}}
                 • {{this.startDate}}{{#if this.isCurrent}} - Present{{else}}{{#if this.endDate}} - {{this.endDate}}{{/if}}{{/if}}
                {{/if}}
            </div>
            {{#if this.bullets}}
            <ul class="bullets">
                {{#each this.bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
            {{#if this.techStack}}
            <div class="tech-stack">
                Technologies: {{#each this.techStack}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
            </div>
            {{/if}}
        </div>
        {{/each}}
    </section>
    {{/if}}

    <!-- ============================================
         SKILLS SECTION
         ============================================ -->
    {{#if skills}}
    <section class="section">
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
            {{#each skills}}
            <div class="skill-category">
                <div class="skill-category-name">{{this.name}}</div>
                <div class="skill-list">
                    {{#each this.skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
                </div>
            </div>
            {{/each}}
        </div>
    </section>
    {{/if}}

</body>
</html>