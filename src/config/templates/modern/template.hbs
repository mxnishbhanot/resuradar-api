<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <style>
    /* Page geometry is owned by Playwright's page.pdf({ format, margin }).
       Typography tiers, spacing tokens, and keep-together rules come from the
       print-spec style block injected by renderTemplateHTML — this template
       only references tier classes and var(--sp-*) tokens. */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    .resume-doc {
      display: flex;
      flex-direction: column;
      gap: var(--sp-5);
    }

    /* Header block */
    .rr-header {
      padding-bottom: var(--sp-3);
      border-bottom: 0.75pt solid var(--rr-border);
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
    }
    .rr-contact-line {
      word-wrap: break-word;
    }
    .rr-contact-line .csep { color: var(--rr-muted); }
    .rr-contact-line a { color: var(--rr-link); }

    /* Section layout */
    .rr-section-body {
      margin-top: var(--sp-4);
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
    }

    /* Entry layout */
    .rr-entry {
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
    }
    .rr-entry-meta .rr-entry-dates { white-space: nowrap; }
    .rr-entry-meta .rr-entry-role  { text-align: right; }

    /* Skills */
    .rr-skill-line + .rr-skill-line { margin-top: var(--sp-2); }
    .rr-skill-line .rr-skill-label { font-weight: 700; color: var(--rr-heading); }
  </style>
</head>
<body class="rr-resume">

<div class="resume-doc">
  <header class="rr-header">
    <div class="rr-name">{{personal.firstName}} {{personal.lastName}}</div>
    {{#if personal.headline}}<div class="rr-headline">{{personal.headline}}</div>{{/if}}
    <div class="rr-contact-line rr-caption">
      {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
      {{#if personal.email}}{{#if personal.location}}<span class="csep"> · </span>{{/if}}<span>{{personal.email}}</span>{{/if}}
      {{#if personal.phone}}<span class="csep"> · </span><span>{{personal.phone}}</span>{{/if}}
      {{#if personal.linkedin}}<span class="csep"> · </span><span><a href="{{hrefUrl personal.linkedin}}">{{personal.linkedin}}</a></span>{{/if}}
      {{#if personal.github}}<span class="csep"> · </span><span><a href="{{hrefUrl personal.github}}">{{personal.github}}</a></span>{{/if}}
      {{#if personal.portfolioUrl}}<span class="csep"> · </span><span><a href="{{hrefUrl personal.portfolioUrl}}">{{personal.portfolioUrl}}</a></span>{{/if}}
    </div>
  </header>

  {{#each sectionOrder}}
    {{#if (eq this "summary")}}
      {{#if @root.personal.summary}}
      <section class="rr-section">
        <div class="rr-section-heading">Summary</div>
        <div class="rr-section-body">
          <div class="rr-body" data-rr-field="personal.summary">{{{fmt @root.personal.summary}}}</div>
        </div>
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "experience")}}
      {{#if @root.experiences.length}}
      <section class="rr-section" data-rr-field="section.experience">
        <div class="rr-section-heading">Experience</div>
        <div class="rr-section-body">
          {{#each @root.experiences}}
          <div class="rr-entry" data-rr-field="experiences.{{@index}}.block">
            <div class="rr-entry-header">
              <div class="rr-entry-title">{{title}}</div>
              <div class="rr-entry-meta">
                {{#if company}}<span class="rr-entry-co">{{company}}</span>{{/if}}
                <span class="rr-entry-dates">
                  {{#if startDate}}{{formatDate startDate}}{{/if}}
                  {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
                </span>
                {{#if role}}<span class="rr-entry-role">{{role}}</span>{{/if}}
              </div>
            </div>
            {{#if bullets.length}}
            <ul class="rr-bullets rr-body">
              {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
            </ul>
            {{/if}}
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "projects")}}
      {{#if @root.projects.length}}
      <section class="rr-section" data-rr-field="section.projects">
        <div class="rr-section-heading">Projects</div>
        <div class="rr-section-body">
          {{#each @root.projects}}
          <div class="rr-entry">
            <div class="rr-entry-header">
              <div class="rr-entry-title">{{title}}</div>
              <div class="rr-entry-meta">
                {{#if role}}<span>{{role}}</span>{{/if}}
                {{#if link}}{{#if role}}<span class="csep"> · </span>{{/if}}<a href="{{hrefUrl link}}">{{link}}</a>{{/if}}
              </div>
            </div>
            {{#if bullets.length}}
            <ul class="rr-bullets rr-body">
              {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
            </ul>
            {{/if}}
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "education")}}
      {{#if @root.educations.length}}
      <section class="rr-section" data-rr-field="section.education">
        <div class="rr-section-heading">Education</div>
        <div class="rr-section-body">
          {{#each @root.educations}}
          <div class="rr-entry">
            <div class="rr-entry-header">
              <div class="rr-entry-title">{{degree}}{{#if major}} ({{major}}){{/if}}</div>
              <div class="rr-entry-meta">
                <span>{{institution}}</span>
                {{#if gpa}}<span class="csep"> · </span><span>{{gpa}}</span>{{/if}}
                {{#if endDate}}<span class="csep"> · </span><span class="rr-entry-dates">{{formatDate endDate}}</span>{{else}}{{#if startDate}}<span class="csep"> · </span><span class="rr-entry-dates">{{formatDate startDate}}</span>{{/if}}{{/if}}
                {{#if isCurrent}}<span class="csep"> · </span><span>Present</span>{{/if}}
              </div>
            </div>
            {{#if bullets.length}}
            <ul class="rr-bullets rr-body">
              {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
            </ul>
            {{/if}}
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}
    {{/if}}

    {{#if (eq this "skills")}}
      {{#if @root.skills.length}}
      <section class="rr-section" data-rr-field="section.skills">
        <div class="rr-section-heading">Skills</div>
        <div class="rr-section-body">
          {{#each @root.skills}}
          <div class="rr-skill-line rr-body">
            <span class="rr-skill-label">{{{fmt name}}}:</span>
            {{#each skills}}{{{fmt this}}}{{#unless @last}}, {{/unless}}{{/each}}.
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}
    {{/if}}
  {{/each}}
</div>

</body>
</html>
