<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{personal.firstName}} {{personal.lastName}} - Resume</title>
    <style>
        /* ============================================
           MODERN GEOMETRIC RESUME TEMPLATE
           Bold Typography | Geometric Elements | Strong Hierarchy
           ============================================ */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 10.5pt;
            line-height: 1.6;
            color: #1a1a1a;
            background: #ffffff;
            max-width: 8.5in;
            margin: 0 auto;
            padding: 0.5in 0.6in;
        }

        /* ============================================
           HEADER - BOLD & GEOMETRIC
           ============================================ */

        .resume-header {
            position: relative;
            margin-bottom: 36px;
            padding-bottom: 28px;
        }

        .resume-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, #000000 0%, #4a4a4a 100%);
        }

        .name {
            font-size: 38pt;
            font-weight: 800;
            letter-spacing: -1.5px;
            color: #000000;
            margin-bottom: 8px;
            line-height: 1.1;
        }

        .headline {
            font-size: 13pt;
            font-weight: 500;
            color: #4a4a4a;
            margin-bottom: 16px;
            letter-spacing: 0.3px;
        }

        .contact-info {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            font-size: 9.5pt;
            color: #4a4a4a;
            font-weight: 500;
        }

        .contact-item {
            position: relative;
            padding-left: 20px;
        }

        .contact-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 12px;
            height: 12px;
            background: #000000;
            clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
        }

        .contact-info a {
            color: #000000;
            text-decoration: none;
            font-weight: 600;
            border-bottom: 2px solid transparent;
            transition: border-color 0.2s;
        }

        .contact-info a:hover {
            border-bottom-color: #000000;
        }

        /* ============================================
           SUMMARY - BOLD BOX
           ============================================ */

        .summary {
            background: #f8f8f8;
            padding: 20px 24px;
            margin-bottom: 32px;
            border-left: 5px solid #000000;
            line-height: 1.7;
            color: #1a1a1a;
            font-size: 10.5pt;
        }

        /* ============================================
           SECTIONS - GEOMETRIC HEADERS
           ============================================ */

        .section {
            margin-bottom: 32px;
        }

        .section-title {
            font-size: 16pt;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #000000;
            margin-bottom: 20px;
            text-transform: uppercase;
            font-size: 12pt;
            letter-spacing: 1.5px;
            position: relative;
            padding-bottom: 12px;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 50px;
            height: 3px;
            background: #000000;
        }

        /* ============================================
           ENTRY BLOCKS - STRONG HIERARCHY
           ============================================ */

        .entry {
            margin-bottom: 24px;
            page-break-inside: avoid;
            position: relative;
            padding-left: 16px;
        }

        .entry::before {
            content: '';
            position: absolute;
            left: 0;
            top: 6px;
            width: 8px;
            height: 8px;
            background: #000000;
            transform: rotate(45deg);
        }

        .entry:last-child {
            margin-bottom: 0;
        }

        .entry-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 6px;
            gap: 12px;
        }

        .entry-title {
            font-size: 12pt;
            font-weight: 700;
            color: #000000;
            letter-spacing: -0.2px;
        }

        .entry-date {
            font-size: 9pt;
            color: #4a4a4a;
            white-space: nowrap;
            font-weight: 600;
            background: #f0f0f0;
            padding: 3px 10px;
            border-radius: 2px;
        }

        .entry-subtitle {
            font-size: 10pt;
            color: #4a4a4a;
            margin-bottom: 10px;
            font-weight: 500;
        }

        .entry-location {
            font-size: 9.5pt;
            color: #6a6a6a;
        }

        /* ============================================
           BULLETS - MODERN STYLE
           ============================================ */

        .bullets {
            list-style: none;
            margin-top: 10px;
        }

        .bullets li {
            position: relative;
            padding-left: 22px;
            margin-bottom: 8px;
            line-height: 1.6;
        }

        .bullets li:before {
            content: '';
            position: absolute;
            left: 0;
            top: 9px;
            width: 6px;
            height: 6px;
            background: #000000;
            transform: rotate(45deg);
        }

        /* ============================================
           SKILLS - GRID LAYOUT
           ============================================ */

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .skill-category {
            background: #f8f8f8;
            padding: 16px 18px;
            border-left: 4px solid #000000;
        }

        .skill-category-name {
            font-size: 10.5pt;
            font-weight: 700;
            color: #000000;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 9pt;
        }

        .skill-list {
            font-size: 9.5pt;
            color: #4a4a4a;
            line-height: 1.7;
            font-weight: 500;
        }

        /* ============================================
           PROJECTS
           ============================================ */

        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 6px;
            gap: 12px;
        }

        .project-title {
            font-size: 12pt;
            font-weight: 700;
            color: #000000;
        }

        .project-link {
            font-size: 9pt;
            color: #000000;
            text-decoration: none;
            font-weight: 700;
            border-bottom: 2px solid #000000;
        }

        .project-link:hover {
            background: #000000;
            color: #ffffff;
            padding: 2px 6px;
            margin: -2px -6px;
        }

        .project-meta {
            font-size: 9.5pt;
            color: #4a4a4a;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .tech-stack {
            font-size: 9pt;
            color: #6a6a6a;
            margin-top: 8px;
            font-weight: 600;
            background: #f0f0f0;
            padding: 6px 12px;
            display: inline-block;
            border-radius: 2px;
        }

        /* ============================================
           EDUCATION
           ============================================ */

        .education-details {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }

        .gpa {
            font-size: 9pt;
            color: #4a4a4a;
            white-space: nowrap;
            font-weight: 600;
            background: #f0f0f0;
            padding: 3px 10px;
            border-radius: 2px;
        }

        /* ============================================
           PRINT OPTIMIZATION
           ============================================ */

        @media print {
            body {
                padding: 0.4in 0.5in;
            }

            .section {
                page-break-inside: avoid;
            }

            .entry {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <!-- ============================================
         HEADER
         ============================================ -->
    <header class="resume-header">
        <h1 class="name">{{personal.firstName}} {{personal.lastName}}</h1>
        {{#if personal.headline}}
        <p class="headline">{{personal.headline}}</p>
        {{/if}}
        <div class="contact-info">
            {{#if personal.email}}
            <div class="contact-item"><a href="mailto:{{personal.email}}">{{personal.email}}</a></div>
            {{/if}}
            {{#if personal.phone}}
            <div class="contact-item">{{personal.phone}}</div>
            {{/if}}
            {{#if personal.location}}
            <div class="contact-item">{{personal.location}}</div>
            {{/if}}
            {{#if personal.linkedin}}
            <div class="contact-item"><a href="{{personal.linkedin}}" target="_blank">LinkedIn</a></div>
            {{/if}}
            {{#if personal.github}}
            <div class="contact-item"><a href="{{personal.github}}" target="_blank">GitHub</a></div>
            {{/if}}
        </div>
    </header>

    <!-- ============================================
         SUMMARY
         ============================================ -->
    {{#if personal.summary}}
    <div class="summary">
        {{personal.summary}}
    </div>
    {{/if}}

    <!-- ============================================
         EXPERIENCE
         ============================================ -->
    {{#if experiences.length}}
    <section class="section">
        <h2 class="section-title">Experience</h2>
        {{#each experiences}}
        <div class="entry">
            <div class="entry-header">
                <h3 class="entry-title">{{this.title}}</h3>
                <span class="entry-date">
                    {{formatDate this.startDate}}{{#if this.isCurrent}} - Present{{else}}{{#if this.endDate}} - {{formatDate this.endDate}}{{/if}}{{/if}}
                </span>
            </div>
            <div class="entry-subtitle">
                {{#if this.company}}{{this.company}}{{/if}}
                {{#if this.location}}<span class="entry-location"> • {{this.location}}</span>{{/if}}
            </div>
            {{#if this.bullets}}
            <ul class="bullets">
                {{#each this.bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
    </section>
    {{/if}}

    <!-- ============================================
         EDUCATION
         ============================================ -->
    {{#if educations.length}}
    <section class="section">
        <h2 class="section-title">Education</h2>
        {{#each educations}}
        <div class="entry">
            <div class="entry-header">
                <h3 class="entry-title">{{this.institution}}</h3>
                <span class="entry-date">
                    {{formatDate this.startDate}}{{#if this.isCurrent}} - Present{{else}}{{#if this.endDate}} - {{formatDate this.endDate}}{{/if}}{{/if}}
                </span>
            </div>
            <div class="education-details">
                <div class="entry-subtitle">
                    {{this.degree}} in {{this.major}}
                </div>
                {{#if this.gpa}}
                <span class="gpa">GPA: {{this.gpa}}</span>
                {{/if}}
            </div>
            {{#if this.bullets}}
            <ul class="bullets">
                {{#each this.bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{/each}}
    </section>
    {{/if}}

    <!-- ============================================
         PROJECTS
         ============================================ -->
    {{#if projects.length}}
    <section class="section">
        <h2 class="section-title">Projects</h2>
        {{#each projects}}
        <div class="entry">
            <div class="project-header">
                <h3 class="project-title">{{this.title}}</h3>
                {{#if this.link}}
                <a href="{{this.link}}" class="project-link" target="_blank">VIEW →</a>
                {{/if}}
            </div>
            <div class="project-meta">
                {{#if this.role}}{{this.role}}{{/if}}
                {{#if this.startDate}}
                 • {{formatDate this.startDate}}{{#if this.isCurrent}} - Present{{else}}{{#if this.endDate}} - {{formatDate this.endDate}}{{/if}}{{/if}}
                {{/if}}
            </div>
            {{#if this.bullets}}
            <ul class="bullets">
                {{#each this.bullets}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
            {{/if}}
            {{#if this.techStack}}
            <div class="tech-stack">
                {{#each this.techStack}}{{this}}{{#unless @last}} • {{/unless}}{{/each}}
            </div>
            {{/if}}
        </div>
        {{/each}}
    </section>
    {{/if}}

    <!-- ============================================
         SKILLS
         ============================================ -->
    {{#if skills.length}}
    <section class="section">
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
            {{#each skills}}
            <div class="skill-category">
                <div class="skill-category-name">{{this.name}}</div>
                <div class="skill-list">
                    {{#each this.skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
                </div>
            </div>
            {{/each}}
        </div>
    </section>
    {{/if}}

</body>
</html>