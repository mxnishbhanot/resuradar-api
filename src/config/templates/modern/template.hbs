<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <style id="resume-styles">
    /* =====================================
       Modern Executive Resume (With Colors)
       Clean • Minimal • Professional
    ===================================== */

    body {
      font-family: "Inter", Arial, sans-serif;
      font-size: 12px;
      color: #222;
      margin: 28px;
      line-height: 1.45;
    }

    .resume { width: 100%; }

    .no-break { page-break-inside: avoid; }


    /* -------- Icons -------- */
    .icon-sm {
      width: 13px;
      height: 13px;
      fill: #2F80ED;
      vertical-align: middle;
      margin-right: 4px;
    }

    .icon-xs {
      width: 10px;
      height: 10px;
      fill: #2F80ED;
      vertical-align: middle;
      margin-right: 4px;
    }


    /* -------- Header -------- */

    .header {
      padding-bottom: 12px;
      border-bottom: 2px solid #2F80ED;
      margin-bottom: 18px;
    }

    .name {
      font-size: 27px;
      font-weight: 700;
      margin: 0;
    }

    .headline {
      font-size: 14px;
      color: #444;
      margin-top: 3px;
    }

    .contact {
      margin-top: 4px;
      font-size: 12px;
    }

    .contact span {
      margin-right: 12px;
      color: #555;
    }


    /* -------- Sections -------- */

    .section {
      margin-top: 20px;
    }

    .section-title {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      color: #2F80ED;
      margin-bottom: 10px;
      letter-spacing: 0.6px;
    }


    /* -------- Text -------- */

    .text { margin: 0; }

    .small { font-size: 11px; color: #555; }


    /* -------- Skill Chips (Modified to handle categories) -------- */

    .skill-categories {
      margin-bottom: 15px;
    }
    
    .skill-category-name {
      font-size: 12px;
      font-weight: 600;
      color: #444;
      margin-bottom: 5px;
      display: block;
    }

    .skill-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 10px;
    }

    .chip {
      background: #F0F4FF;
      border: 1px solid #D6E2FF;
      color: #2F80ED;
      padding: 3px 8px;
      font-size: 11px;
      border-radius: 6px;
    }


    /* -------- Experience -------- */

    .exp-item {
      margin-bottom: 14px;
    }

    .exp-header {
      display: flex;
      justify-content: space-between;
    }

    .exp-role {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
    }

    .exp-company {
      margin: 0;
      font-size: 12px;
      color: #555;
    }

    .exp-date {
      font-size: 11px;
      color: #2F80ED;
      white-space: nowrap;
    }

    .bullets {
      margin: 5px 0 0 18px;
      padding: 0;
    }

    .bullets li {
      margin-bottom: 3px;
      line-height: 1.4;
    }


    /* -------- Education -------- */

    .edu-item { margin-bottom: 14px; }

    .edu-header {
      display: flex;
      justify-content: space-between;
    }

    .edu-degree {
      margin: 0;
      font-size: 13px;
      font-weight: 600;
    }

    .edu-school {
      margin: 0;
      font-size: 12px;
      color: #555;
    }

    .edu-date {
      font-size: 11px;
      color: #2F80ED;
      white-space: nowrap;
    }


    /* -------- Projects -------- */

    .proj-item { margin-bottom: 14px; }

    .proj-title {
      margin: 0;
      font-size: 13px;
      font-weight: 600;
    }
    
    .proj-role {
      font-size: 12px;
      color: #555;
      margin: 0 0 3px 0;
    }

    .proj-link {
      font-size: 12px;
      color: #2F80ED;
      text-decoration: underline;
      word-break: break-all;
      margin-top: 3px;
    }


    .proj-tech-stack {
      font-size: 11px;
      color: #555;
      margin: 5px 0 0 0;
    }
    
    .proj-bullets {
      margin: 5px 0 0 18px;
      padding: 0;
    }
    
    .proj-bullets li {
      margin-bottom: 3px;
      line-height: 1.4;
    }

  </style>
</head>

<body>

<div class="resume">

  <!-- ============ HEADER ============ -->
  <header class="header no-break">
    <h1 class="name">{{personal.firstName}} {{personal.lastName}}</h1>

    {{#if personal.headline}}
    <p class="headline">{{personal.headline}}</p>
    {{/if}}

    <div class="contact">

      {{#if personal.email}}
      <span>
        <!-- email icon -->
        <svg class="icon-sm" viewBox="0 0 24 24"><path d="M2 4h20v16H2V4zm10 7L3.5 6h17L12 11z"/></svg>
        {{personal.email}}
      </span>
      {{/if}}

      {{#if personal.phone}}
      <span>
        <!-- phone icon -->
        <svg class="icon-sm" viewBox="0 0 24 24"><path d="M6.6 10.8c1.2 2.4 3.1 4.3 5.5 5.5l1.8-1.8c.3-.3.7-.4 1.1-.3 1.2.4 2.5.7 3.8.7.6 0 1 .4 1 .9v3c0 .6-.4 1-1 1C9.4 21.8 2.2 14.6 2.2 6c0-.6.4-1 1-1h3c.6 0 .9.4.9 1 0 1.3.2 2.6.7 3.8.1.4 0 .8-.3 1.1l-1.9 1.9z"/></svg>
        {{personal.phone}}
      </span>
      {{/if}}

      {{#if personal.location}}
      <span>
        <!-- location icon -->
        <svg class="icon-sm" viewBox="0 0 24 24"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/></svg>
        {{personal.location}}
      </span>
      {{/if}}
      
      {{#if personal.linkedin}}
      <span>
        <!-- link icon -->
        <svg class="icon-sm" viewBox="0 0 24 24"><path d="M17 7h-2V5h2c1.7 0 3 1.3 3 3v8c0 1.7-1.3 3-3 3h-8c-1.7 0-3-1.3-3-3v-2h2v2c0 .6.4 1 1 1h8c.6 0 1-.4 1-1V8c0-.6-.4-1-1-1zM5 14h2v2H5v-2zm-3-3h2v2H2v-2zm0-4h2v2H2V7zm0-4h2v2H2V3zm12-1h-2v2h2V2zm0 4h-2v2h2V6zM8 12h2v2H8v-2zm0-4h2v2H8V8z"/></svg>
        LinkedIn
      </span>
      {{/if}}
      
      {{#if personal.github}}
      <span>
        <!-- code icon -->
        <svg class="icon-sm" viewBox="0 0 24 24"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>
        GitHub
      </span>
      {{/if}}

    </div>
  </header>


  <!-- ============ SUMMARY ============ -->
  {{#if personal.summary}}
  <section class="section">
    <h2 class="section-title">Executive Summary</h2>
    <p class="text">{{personal.summary}}</p>
  </section>
  {{/if}}


  <!-- ============ CORE SKILLS (Iterates Categories) ============ -->
  {{#if skills.length}}
  <section class="section">
    <h2 class="section-title">Core Competencies</h2>

    {{#each skills}}
    <div class="skill-categories no-break">
        <span class="skill-category-name">{{name}}</span>
        <div class="skill-chips">
          {{#each skills}}
          <span class="chip">
            <!-- check icon -->
            <svg class="icon-xs" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
            {{this}}
          </span>
          {{/each}}
        </div>
    </div>
    {{/each}}
  </section>
  {{/if}}


  <!-- ============ EXPERIENCE ============ -->
  {{#if experiences.length}}
  <section class="section">
    <h2 class="section-title">Leadership Experience</h2>

    {{#each experiences}}
    <div class="exp-item no-break">

      <div class="exp-header">
        <div>
          <h3 class="exp-role">{{title}}</h3>
          {{#if company}}<p class="exp-company">{{company}}</p>{{/if}}
        </div>

        <span class="exp-date">{{startDate}} – {{#if isCurrent}}Present{{else}}{{endDate}}{{/if}}</span>
      </div>

      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

    </div>
    {{/each}}
    
  </section>
  {{/if}}


  <!-- ============ EDUCATION (Fixed field names) ============ -->
  {{#if educations.length}}
  <section class="section">
    <h2 class="section-title">Education</h2>

    {{#each educations}}
    <div class="edu-item no-break">

      <div class="edu-header">
        <div>
          <!-- FIX: Use major field -->
          <h3 class="edu-degree">{{degree}} {{#if major}}in {{major}}{{/if}}</h3>
          <!-- FIX: Use institution field -->
          <p class="edu-school">{{institution}}</p>
          {{#if gpa}}<p class="edu-gpa small">GPA: {{gpa}}</p>{{/if}}
        </div>

        <span class="edu-date">
          {{startDate}} – {{#if isCurrent}}Present{{else}}{{endDate}}{{/if}}
        </span>
      </div>

      <!-- FIX: Use bullets array (which replaces 'description') -->
      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

    </div>
    {{/each}}

  </section>
  {{/if}}


  <!-- ============ PROJECTS (Fixed field names and structure) ============ -->
  {{#if projects.length}}
  <section class="section">
    <h2 class="section-title">Key Projects</h2>

    {{#each projects}}
    <div class="proj-item no-break">
      <h3 class="proj-title">{{title}}</h3>
      
      {{#if role}}
      <p class="proj-role">{{role}}</p>
      {{/if}}

      <span class="exp-date">{{startDate}} – {{#if isCurrent}}Present{{else}}{{endDate}}{{/if}}</span>

      {{#if link}}
      <p class="proj-link">{{link}}</p>
      {{/if}}

      <!-- FIX: Use bullets array (which replaces 'description') -->
      {{#if bullets.length}}
      <ul class="proj-bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

      <!-- FIX: Use techStack array (which replaces 'tech') -->
      {{#if techStack.length}}
      <p class="proj-tech-stack">
        <strong>Technologies:</strong>
        {{#each techStack}}
        {{this}}{{#unless @last}}, {{/unless}}
        {{/each}}
      </p>
      {{/if}}
    </div>
    {{/each}}

  </section>
  {{/if}}

</div>

</body>
</html>