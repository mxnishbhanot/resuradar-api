<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{personal.firstName}} {{personal.lastName}} - Resume</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      font-size: 10pt;
      line-height: 1.5;
      color: #1a1a1a;
      background: #ffffff;
      padding: 0.4in 0.6in;
      max-width: 8.5in;
      margin: 0 auto;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Header Section */
    .header {
      margin-bottom: 18pt;
      position: relative;
    }

    .header-main {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 12pt;
      border-bottom: 2pt solid #0066cc;
      margin-bottom: 10pt;
    }

    .header-left {
      flex: 1;
    }

    .header h1 {
      font-size: 26pt;
      font-weight: 700;
      color: #0066cc;
      margin-bottom: 3pt;
      letter-spacing: -0.5pt;
    }

    .header .headline {
      font-size: 12pt;
      font-weight: 500;
      color: #2c3e50;
      margin-bottom: 8pt;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(2, auto);
      gap: 4pt 16pt;
      font-size: 9pt;
      color: #4a5568;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 4pt;
    }

    .contact-icon {
      width: 12pt;
      height: 12pt;
      display: inline-block;
    }

    /* Two Column Layout */
    .resume-body {
      display: grid;
      grid-template-columns: 0.95fr 2.2fr;
      gap: 14pt;
    }

    .left-column {
      padding-right: 10pt;
      border-right: 1pt solid #e2e8f0;
    }

    .right-column {
      padding-left: 2pt;
    }

    /* Section Styles */
    .section {
      margin-bottom: 14pt;
      page-break-inside: avoid;
    }

    .section-title {
      font-size: 11pt;
      font-weight: 700;
      color: #0066cc;
      text-transform: uppercase;
      letter-spacing: 0.8pt;
      margin-bottom: 8pt;
      position: relative;
      padding-bottom: 4pt;
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 30pt;
      height: 2pt;
      background: linear-gradient(90deg, #0066cc 0%, #00a8ff 100%);
    }

    /* Summary */
    .summary {
      font-size: 9.5pt;
      line-height: 1.55;
      color: #2d3748;
      text-align: justify;
      hyphens: auto;
    }

    /* Skills */
    .skill-category {
      margin-bottom: 8pt;
      padding: 6pt 8pt;
      background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
      border-left: 3pt solid #0066cc;
      border-radius: 2pt;
    }

    .skill-category-name {
      font-size: 9.5pt;
      font-weight: 700;
      color: #1a202c;
      margin-bottom: 3pt;
      display: block;
    }

    .skill-items {
      font-size: 8.5pt;
      line-height: 1.4;
      color: #4a5568;
    }

    /* Entry Styles */
    .entry {
      margin-bottom: 12pt;
      position: relative;
      padding-left: 12pt;
      border-left: 2pt solid #e2e8f0;
    }

    .entry::before {
      content: '';
      position: absolute;
      left: -5pt;
      top: 5pt;
      width: 8pt;
      height: 8pt;
      background: #0066cc;
      border-radius: 50%;
      border: 2pt solid #ffffff;
      box-shadow: 0 0 0 1pt #e2e8f0;
    }

    .entry-header {
      margin-bottom: 4pt;
    }

    .entry-title-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 2pt;
    }

    .entry-title {
      font-size: 11pt;
      font-weight: 700;
      color: #1a202c;
      line-height: 1.3;
    }

    .entry-company {
      font-size: 10pt;
      font-weight: 600;
      color: #2d3748;
      margin-bottom: 1pt;
    }

    .entry-role {
      font-size: 9pt;
      color: #4a5568;
      font-style: italic;
    }

    .entry-date {
      font-size: 8.5pt;
      color: #718096;
      font-weight: 500;
      white-space: nowrap;
      padding: 2pt 6pt;
      background: #f7fafc;
      border-radius: 2pt;
    }

    .entry-date.current {
      background: linear-gradient(135deg, #e6f7ff 0%, #cce7ff 100%);
      color: #0066cc;
      font-weight: 600;
    }

    /* Bullets */
    .entry-bullets {
      margin-left: 12pt;
      margin-top: 5pt;
      list-style: none;
    }

    .entry-bullets li {
      font-size: 9pt;
      line-height: 1.5;
      margin-bottom: 3pt;
      color: #2d3748;
      position: relative;
      padding-left: 12pt;
    }

    .entry-bullets li::before {
      content: '▹';
      position: absolute;
      left: 0;
      color: #0066cc;
      font-weight: bold;
      font-size: 10pt;
    }

    /* Tech Stack */
    .tech-stack {
      margin-top: 4pt;
      padding: 4pt 8pt;
      background: #f7fafc;
      border-radius: 2pt;
      font-size: 8.5pt;
      line-height: 1.4;
    }

    .tech-stack-label {
      font-weight: 700;
      color: #2d3748;
      display: inline;
    }

    .tech-stack-items {
      color: #4a5568;
      display: inline;
    }

    .tech-tag {
      display: inline-block;
      padding: 1pt 5pt;
      background: #ffffff;
      border: 0.5pt solid #cbd5e0;
      border-radius: 2pt;
      margin: 2pt 2pt 2pt 0;
      font-size: 8pt;
      color: #4a5568;
    }

    /* Education specific */
    .education-entry .entry-title {
      color: #0066cc;
    }

    .gpa {
      font-size: 9pt;
      color: #2d3748;
      font-weight: 600;
      margin-left: 8pt;
      padding: 1pt 6pt;
      background: #f0f9ff;
      border-radius: 2pt;
    }

    /* Projects specific */
    .project-link {
      font-size: 8pt;
      color: #0066cc;
      text-decoration: none;
      margin-left: 6pt;
      font-weight: 500;
    }

    /* Left Column Specific Styles */
    .left-section .section-title {
      font-size: 10pt;
    }

    .compact-entry {
      margin-bottom: 10pt;
      padding: 0;
      border: none;
    }

    .compact-entry::before {
      display: none;
    }

    /* Print Optimization */
    @media print {
      body {
        padding: 0.4in 0.6in;
        max-width: 100%;
      }
      
      .entry {
        page-break-inside: avoid;
      }
      
      .section {
        page-break-inside: avoid;
      }
    }

    /* Responsive adjustments */
    @page {
      margin: 0;
      size: letter;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <div class="header">
    <div class="header-main">
      <div class="header-left">
        <h1>{{personal.firstName}} {{personal.lastName}}</h1>
        {{#if personal.headline}}
          <div class="headline">{{personal.headline}}</div>
        {{/if}}
      </div>
    </div>
    
    <div class="contact-grid">
      {{#if personal.email}}
        <div class="contact-item">
          <span class="contact-icon">✉</span>
          <span>{{personal.email}}</span>
        </div>
      {{/if}}
      {{#if personal.phone}}
        <div class="contact-item">
          <span class="contact-icon">☎</span>
          <span>{{personal.phone}}</span>
        </div>
      {{/if}}
      {{#if personal.location}}
        <div class="contact-item">
          <span class="contact-icon">📍</span>
          <span>{{personal.location}}</span>
        </div>
      {{/if}}
    </div>
  </div>

  <!-- Two Column Layout -->
  <div class="resume-body">
    
    <!-- Left Column -->
    <div class="left-column">
      
      <!-- Skills -->
      {{#if skills.length}}
      <div class="section left-section">
        <div class="section-title">Skills</div>
        {{#each skills}}
          <div class="skill-category">
            <span class="skill-category-name">{{name}}</span>
            <div class="skill-items">
              {{#each skills}}{{this}}{{#unless @last}} • {{/unless}}{{/each}}
            </div>
          </div>
        {{/each}}
      </div>
      {{/if}}

      <!-- Education -->
      {{#if educations.length}}
      <div class="section left-section">
        <div class="section-title">Education</div>
        {{#each educations}}
          <div class="compact-entry education-entry">
            <div class="entry-title">{{degree}}</div>
            <div class="entry-company">{{major}}</div>
            <div class="entry-role">
              {{institution}}
              {{#if gpa}}<span class="gpa">{{gpa}}</span>{{/if}}
            </div>
            <div class="entry-date {{#if isCurrent}}current{{/if}}">
              {{#if startDate}}{{formatDate startDate "MMM YYYY"}}{{/if}}
              {{#if isCurrent}}
                – Present
              {{else}}
                {{#if endDate}} – {{formatDate endDate "MMM YYYY"}}{{/if}}
              {{/if}}
            </div>
            {{#if bullets.length}}
              <ul class="entry-bullets">
                {{#each bullets}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>
            {{/if}}
          </div>
        {{/each}}
      </div>
      {{/if}}

    </div>

    <!-- Right Column -->
    <div class="right-column">
      
      <!-- Summary -->
      {{#if personal.summary}}
      <div class="section">
        <div class="section-title">Professional Summary</div>
        <div class="summary">{{personal.summary}}</div>
      </div>
      {{/if}}

      <!-- Work Experience -->
      {{#if experiences.length}}
      <div class="section">
        <div class="section-title">Professional Experience</div>
        {{#each experiences}}
          <div class="entry">
            <div class="entry-header">
              <div class="entry-title-row">
                <div>
                  <div class="entry-title">{{title}}</div>
                  {{#if company}}
                    <div class="entry-company">{{company}}</div>
                  {{/if}}
                  {{#if role}}
                    <div class="entry-role">{{role}}</div>
                  {{/if}}
                </div>
                <div class="entry-date {{#if isCurrent}}current{{/if}}">
                  {{#if startDate}}{{formatDate startDate "MMM YYYY"}}{{/if}}
                  {{#if isCurrent}}
                    – Present
                  {{else}}
                    {{#if endDate}} – {{formatDate endDate "MMM YYYY"}}{{/if}}
                  {{/if}}
                </div>
              </div>
            </div>
            {{#if bullets.length}}
              <ul class="entry-bullets">
                {{#each bullets}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>
            {{/if}}
          </div>
        {{/each}}
      </div>
      {{/if}}

      <!-- Projects -->
      {{#if projects.length}}
      <div class="section">
        <div class="section-title">Featured Projects</div>
        {{#each projects}}
          <div class="entry">
            <div class="entry-header">
              <div class="entry-title-row">
                <div>
                  <div class="entry-title">
                    {{title}}
                    {{#if link}}
                      <a href="{{link}}" class="project-link">🔗 View</a>
                    {{/if}}
                  </div>
                  {{#if role}}
                    <div class="entry-role">{{role}}</div>
                  {{/if}}
                </div>
                <div class="entry-date">
                  {{#if startDate}}{{formatDate startDate "MMM YYYY"}}{{/if}}
                  {{#if isCurrent}}
                    – Present
                  {{else}}
                    {{#if endDate}} – {{formatDate endDate "MMM YYYY"}}{{/if}}
                  {{/if}}
                </div>
              </div>
            </div>
            {{#if techStack.length}}
              <div class="tech-stack">
                <span class="tech-stack-label">Tech Stack:</span>
                <span class="tech-stack-items">
                  {{#each techStack}}<span class="tech-tag">{{this}}</span>{{/each}}
                </span>
              </div>
            {{/if}}
            {{#if bullets.length}}
              <ul class="entry-bullets">
                {{#each bullets}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>
            {{/if}}
          </div>
        {{/each}}
      </div>
      {{/if}}

    </div>
  </div>

</body>
</html>