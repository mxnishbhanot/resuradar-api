<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <style>
    @page { margin: 0; size: A4; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-size: 10.5pt;
      line-height: calc(1.35 * var(--rr-line-height-mul, 1));
      color: var(--rr-ink);
      background: var(--rr-bg);
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    /* Header: name + single contact line (reference resume layout) */
    .header {
      margin-bottom: calc(11pt * var(--rr-section-gap-mul, 1));
      padding-bottom: 8pt;
      border-bottom: 0.75pt solid var(--rr-border);
    }
    .name {
      font-size: 22pt;
      font-weight: 700;
      letter-spacing: 0;
      color: var(--rr-heading);
      line-height: 1.15;
    }
    .headline {
      font-size: 10.5pt;
      color: var(--rr-muted);
      font-weight: 600;
      margin-top: 5pt;
    }
    .contact-line {
      margin-top: 6pt;
      font-size: 10pt;
      font-weight: 400;
      color: var(--rr-muted);
      line-height: 1.45;
      word-wrap: break-word;
    }
    .contact-line .csep { color: var(--rr-muted); font-weight: 400; }
    .contact-line a { color: var(--rr-link); font-weight: 400; }

    .section {
      margin-bottom: calc(11pt * var(--rr-section-gap-mul, 1));
      page-break-inside: avoid;
    }
    .section-title {
      font-size: 10.5pt;
      font-weight: var(--rr-heading-weight, 700);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--rr-heading);
      margin: 0 0 7pt 0;
      padding-bottom: 3pt;
      border-bottom: 0.5pt solid var(--rr-border);
    }
    .summary {
      font-size: 10pt;
      color: var(--rr-ink);
      line-height: 1.45;
      text-align: left;
    }

    /* Experience / project entries — no left rail bullets */
    .entry {
      margin-bottom: 10pt;
      page-break-inside: avoid;
      padding-left: 0;
    }
    .entry::before { display: none; }
    .exp-title {
      font-size: 10.5pt;
      font-weight: 700;
      color: var(--rr-heading);
      line-height: 1.25;
    }
    .exp-meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: 6pt 12pt;
      margin-top: 2pt;
      font-size: 10pt;
      color: var(--rr-muted);
      font-weight: 400;
    }
    .exp-meta .exp-co { font-weight: 400; color: var(--rr-ink); }
    .exp-meta .exp-dates { white-space: nowrap; }
    .exp-meta .exp-role { text-align: right; flex: 1; min-width: 8em; }

    ul.bullets {
      list-style: none;
      margin: 5pt 0 0 0;
      padding: 0;
    }
    ul.bullets li {
      position: relative;
      padding-left: 12pt;
      margin-bottom: 3pt;
      font-size: 10pt;
      color: var(--rr-ink);
      line-height: 1.4;
      text-align: left;
    }
    ul.bullets li::before {
      content: '•';
      position: absolute;
      left: 0;
      top: 0;
      color: var(--rr-ink);
      font-weight: 400;
    }

    /* Projects — title + org · link (reference layout) */
    .proj-title {
      font-size: 10.5pt;
      font-weight: 700;
      color: var(--rr-heading);
      line-height: 1.25;
    }
    .proj-sub {
      margin-top: 2pt;
      font-size: 10pt;
      color: var(--rr-muted);
    }
    .proj-sub a { color: var(--rr-link); }

    /* Education — degree, then school • location • date */
    .edu-degree {
      font-size: 10.5pt;
      font-weight: 700;
      color: var(--rr-heading);
      line-height: 1.25;
    }
    .edu-line {
      margin-top: 2pt;
      font-size: 10pt;
      color: var(--rr-muted);
    }

    /* Skills — "Backend: a, b, c." lines */
    .skill-line {
      font-size: 10pt;
      line-height: 1.45;
      color: var(--rr-ink);
      margin-bottom: 4pt;
      text-align: left;
    }
    .skill-line .lab {
      font-weight: 700;
      color: var(--rr-heading);
    }
  </style>
</head>
<body class="rr-resume">

  <header class="header">
    <div class="name">{{personal.firstName}} {{personal.lastName}}</div>
    {{#if personal.headline}}<div class="headline">{{personal.headline}}</div>{{/if}}
    <div class="contact-line">
      {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
      {{#if personal.email}}{{#if personal.location}}<span class="csep"> · </span>{{/if}}<span>{{personal.email}}</span>{{/if}}
      {{#if personal.phone}}<span class="csep"> · </span><span>{{personal.phone}}</span>{{/if}}
      {{#if personal.linkedin}}<span class="csep"> · </span><span><a href="{{hrefUrl personal.linkedin}}">{{personal.linkedin}}</a></span>{{/if}}
      {{#if personal.github}}<span class="csep"> · </span><span><a href="{{hrefUrl personal.github}}">{{personal.github}}</a></span>{{/if}}
      {{#if personal.portfolioUrl}}<span class="csep"> · </span><span><a href="{{hrefUrl personal.portfolioUrl}}">{{personal.portfolioUrl}}</a></span>{{/if}}
    </div>
  </header>

  {{#each sectionOrder}}
    {{#if (eq this "summary")}}
      {{#if @root.personal.summary}}
      <section class="section">
        <div class="section-title">Summary</div>
        <div class="summary" data-rr-field="personal.summary">{{{fmt @root.personal.summary}}}</div>
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "experience")}}
      {{#if @root.experiences.length}}
      <section class="section" data-rr-field="section.experience">
        <div class="section-title">Experience</div>
        {{#each @root.experiences}}
        <div class="entry" data-rr-field="experiences.{{@index}}.block">
          <div class="exp-title">{{title}}</div>
          <div class="exp-meta">
            <span class="exp-co">{{#if company}}{{company}}{{/if}}</span>
            <span class="exp-dates">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
            </span>
            {{#if role}}<span class="exp-role">{{role}}</span>{{/if}}
          </div>
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "projects")}}
      {{#if @root.projects.length}}
      <section class="section" data-rr-field="section.projects">
        <div class="section-title">Project</div>
        {{#each @root.projects}}
        <div class="entry">
          <div class="proj-title">{{title}}</div>
          <div class="proj-sub">
            {{#if role}}{{role}}{{/if}}
            {{#if link}}{{#if role}}<span> · </span>{{/if}}<a href="{{hrefUrl link}}">{{link}}</a>{{/if}}
          </div>
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "education")}}
      {{#if @root.educations.length}}
      <section class="section" data-rr-field="section.education">
        <div class="section-title">Education</div>
        {{#each @root.educations}}
        <div class="entry">
          <div class="edu-degree">{{degree}}{{#if major}} ({{major}}){{/if}}</div>
          <div class="edu-line">
            {{institution}}
            {{#if gpa}} · {{gpa}}{{/if}}
            {{#if endDate}} · {{formatDate endDate}}{{else}}{{#if startDate}} · {{formatDate startDate}}{{/if}}{{/if}}
            {{#if isCurrent}} · Present{{/if}}
          </div>
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "skills")}}
      {{#if @root.skills.length}}
      <section class="section" data-rr-field="section.skills">
        <div class="section-title">Skills</div>
        {{#each @root.skills}}
        <div class="skill-line">
          <span class="lab">{{{fmt name}}}:</span>
          {{#each skills}}{{{fmt this}}}{{#unless @last}}, {{/unless}}{{/each}}.
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
  {{/each}}

</body>
</html>
