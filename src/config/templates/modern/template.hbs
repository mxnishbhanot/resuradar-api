<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
  <style>
    @page { margin: 0; size: A4; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --ink: #0f172a;
      --muted: #64748b;
      --line: #e2e8f0;
      --accent: #0f766e;
      --accent-soft: #ccfbf1;
    }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      font-size: 9.75pt;
      line-height: 1.45;
      color: var(--ink);
      background: #fff;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .top {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16pt;
      padding-bottom: 12pt;
      margin-bottom: 12pt;
      border-bottom: 2pt solid var(--accent);
    }
    .name {
      font-size: 21pt;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--ink);
      line-height: 1.1;
    }
    .headline { font-size: 10.5pt; color: var(--muted); font-weight: 500; margin-top: 4pt; }
    .contact-col { text-align: right; font-size: 8.75pt; color: var(--muted); font-weight: 500; line-height: 1.5; }
    .grid {
      display: grid;
      grid-template-columns: 0.88fr 2.1fr;
      gap: 14pt;
    }
    .rail { border-right: 1pt solid var(--line); padding-right: 12pt; }
    .main { padding-left: 2pt; }
    .section { margin-bottom: calc(12pt * var(--rr-section-gap-mul, 1)); page-break-inside: avoid; }
    .section-title {
      font-size: 8.5pt;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 7pt;
    }
    .summary {
      font-size: 9.75pt;
      color: #334155;
      line-height: 1.5;
      text-align: justify;
    }
    .pill-skill {
      margin-bottom: 8pt;
      padding: 6pt 8pt;
      background: var(--accent-soft);
      border-radius: 3pt;
      border-left: 3pt solid var(--accent);
    }
    .pill-skill .lab { font-size: 8.75pt; font-weight: 700; color: var(--ink); margin-bottom: 2pt; }
    .pill-skill .vals { font-size: 8.25pt; color: #475569; }
    .entry { margin-bottom: 11pt; page-break-inside: avoid; position: relative; padding-left: 10pt; }
    .entry::before {
      content: '';
      position: absolute;
      left: 0;
      top: 4pt;
      width: 5pt;
      height: 5pt;
      border-radius: 50%;
      background: var(--accent);
    }
    .row { display: flex; justify-content: space-between; gap: 10pt; align-items: baseline; }
    .t1 { font-size: 10.25pt; font-weight: 700; color: var(--ink); }
    .t2 { font-size: 9.25pt; font-weight: 600; color: #334155; margin-top: 1pt; }
    .t3 { font-size: 8.75pt; color: var(--muted); font-style: italic; }
    .dt { font-size: 8.25pt; font-weight: 600; color: var(--accent); white-space: nowrap; background: #f0fdfa; padding: 2pt 6pt; border-radius: 2pt; }
    ul.bullets { list-style: none; margin: 5pt 0 0 0; padding: 0; }
    ul.bullets li {
      position: relative;
      padding-left: 11pt;
      margin-bottom: 3pt;
      font-size: 9pt;
      color: #334155;
      line-height: 1.45;
    }
    ul.bullets li::before {
      content: '›';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-weight: 700;
    }
    .tags { margin-top: 4pt; }
    .tag {
      display: inline-block;
      font-size: 7.5pt;
      padding: 2pt 5pt;
      margin: 2pt 4pt 0 0;
      border: 0.5pt solid #cbd5e1;
      border-radius: 2pt;
      color: #475569;
      font-weight: 500;
    }
    .compact .entry::before { display: none; }
    .compact { padding-left: 0; }
    a { color: var(--accent); text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>

  <div class="top">
    <div>
      <div class="name">{{personal.firstName}} {{personal.lastName}}</div>
      {{#if personal.headline}}<div class="headline">{{personal.headline}}</div>{{/if}}
    </div>
    <div class="contact-col">
      {{#if personal.email}}<div>{{personal.email}}</div>{{/if}}
      {{#if personal.phone}}<div>{{personal.phone}}</div>{{/if}}
      {{#if personal.location}}<div>{{personal.location}}</div>{{/if}}
      {{#if personal.linkedin}}<div><a href="{{hrefUrl personal.linkedin}}">LinkedIn</a></div>{{/if}}
      {{#if personal.portfolioUrl}}<div><a href="{{hrefUrl personal.portfolioUrl}}">Portfolio</a></div>{{/if}}
      {{#if personal.github}}<div><a href="{{hrefUrl personal.github}}">GitHub</a></div>{{/if}}
    </div>
  </div>

  <div class="grid">
    <aside class="rail">
      {{#each sectionOrder}}
        {{#if (eq this "skills")}}
          {{#if @root.skills.length}}
          <section class="section" data-rr-field="section.skills">
            <div class="section-title">Skills</div>
            {{#each @root.skills}}
            <div class="pill-skill">
              <div class="lab">{{name}}</div>
              <div class="vals">{{#each skills}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</div>
            </div>
            {{/each}}
          </section>
          {{/if}}
        {{/if}}
        {{#if (eq this "education")}}
          {{#if @root.educations.length}}
          <section class="section compact" data-rr-field="section.education">
            <div class="section-title">Education</div>
            {{#each @root.educations}}
            <div class="entry">
              <div class="t1">{{degree}}</div>
              {{#if major}}<div class="t2">{{major}}</div>{{/if}}
              <div class="t3">{{institution}}{{#if gpa}} · {{gpa}}{{/if}}</div>
              <div class="dt" style="margin-top:4pt;display:inline-block;">
                {{#if startDate}}{{formatDate startDate}}{{/if}}
                {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
              </div>
              {{#if bullets.length}}
              <ul class="bullets">
                {{#each bullets}}<li>{{this}}</li>{{/each}}
              </ul>
              {{/if}}
            </div>
            {{/each}}
          </section>
          {{/if}}
        {{/if}}
      {{/each}}
    </aside>

    <main class="main">
      {{#each sectionOrder}}
        {{#if (eq this "summary")}}
          {{#if @root.personal.summary}}
          <section class="section">
            <div class="section-title">Summary</div>
            <div class="summary" data-rr-field="personal.summary">{{@root.personal.summary}}</div>
          </section>
          {{/if}}
        {{/if}}
        {{#if (eq this "experience")}}
          {{#if @root.experiences.length}}
          <section class="section" data-rr-field="section.experience">
            <div class="section-title">Experience</div>
            {{#each @root.experiences}}
            <div class="entry" data-rr-field="experiences.{{@index}}.block">
              <div class="row">
                <div>
                  <div class="t1">{{title}}</div>
                  {{#if company}}<div class="t2">{{company}}</div>{{/if}}
                  {{#if role}}<div class="t3">{{role}}</div>{{/if}}
                </div>
                <div class="dt">
                  {{#if startDate}}{{formatDate startDate}}{{/if}}
                  {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
                </div>
              </div>
              {{#if bullets.length}}
              <ul class="bullets">
                {{#each bullets}}<li>{{this}}</li>{{/each}}
              </ul>
              {{/if}}
            </div>
            {{/each}}
          </section>
          {{/if}}
        {{/if}}
        {{#if (eq this "projects")}}
          {{#if @root.projects.length}}
          <section class="section" data-rr-field="section.projects">
            <div class="section-title">Projects</div>
            {{#each @root.projects}}
            <div class="entry">
              <div class="row">
                <div>
                  <div class="t1">{{title}}{{#if link}} <a href="{{link}}">↗</a>{{/if}}</div>
                  {{#if role}}<div class="t3">{{role}}</div>{{/if}}
                </div>
                <div class="dt">
                  {{#if startDate}}{{formatDate startDate}}{{/if}}
                  {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
                </div>
              </div>
              {{#if techStack.length}}
              <div class="tags">{{#each techStack}}<span class="tag">{{this}}</span>{{/each}}</div>
              {{/if}}
              {{#if bullets.length}}
              <ul class="bullets">
                {{#each bullets}}<li>{{this}}</li>{{/each}}
              </ul>
              {{/if}}
            </div>
            {{/each}}
          </section>
          {{/if}}
        {{/if}}
      {{/each}}
    </main>
  </div>

</body>
</html>
