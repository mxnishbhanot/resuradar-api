<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <style id="resume-styles">
    /* ---------------------------
       CORPORATE EXECUTIVE STYLE
       Clean, ATS Safe, Classic Look
    ---------------------------- */

    body {
      font-family: "Times New Roman", serif;
      font-size: 12px;
      color: #000;
      margin: 25px;
      line-height: 1.4; /* Slightly tighter line height for classic look */
    }

    .resume {
      width: 100%;
    }

    .no-break {
      page-break-inside: avoid;
    }

    /* -------- HEADER -------- */

    .header {
      border-bottom: 2px solid #000;
      padding-bottom: 6px;
      margin-bottom: 12px;
      text-align: center;
    }

    .name {
      font-size: 24px; /* Slightly reduced font size for formal look */
      font-weight: bold;
      margin: 0;
    }

    .headline {
      font-size: 13px;
      margin: 2px 0;
    }

    .contact {
      font-size: 11px;
      margin-top: 4px;
    }

    .contact span:after {
      content: " | ";
    }

    .contact span:last-child:after {
      content: "";
    }

    /* -------- SECTIONS -------- */

    .section {
      margin-top: 14px; /* Reduced margin */
    }

    .section-title {
      font-size: 14px; /* Slightly reduced font size */
      font-weight: bold;
      text-transform: uppercase;
      border-bottom: 1px solid #000; /* Simple bottom border */
      padding-bottom: 2px;
      margin-bottom: 6px;
      letter-spacing: 0.5px;
    }

    /* -------- TEXT -------- */

    .text {
      margin: 0;
      line-height: 1.3;
    }

    .small {
      font-size: 11px;
    }

    /* -------- SKILLS (Categorized, Comma-Separated) -------- */
    
    .skill-category {
      margin-bottom: 4px;
      line-height: 1.4;
    }
    
    .skill-category-name {
      font-weight: bold;
      font-size: 12px;
      display: inline;
    }

    .skill-list {
      list-style-type: none;
      padding-left: 0;
      margin: 0;
      display: inline;
      font-size: 12px;
      font-weight: normal;
    }

    .skill-list li {
      display: inline;
      font-weight: normal;
    }

    .skill-list li:not(:last-child)::after {
      content: ", "; /* Use comma separator */
      font-weight: normal;
    }
    
    .skill-list li:last-child::after {
      content: ".";
    }

    /* -------- ITEMS (Experience, Education, Projects) -------- */

    .item {
      margin-bottom: 10px;
    }

    .item-row {
      display: flex;
      justify-content: space-between;
    }

    .item-title {
      margin: 0;
      font-size: 13px;
      font-weight: bold;
    }

    .company {
      margin: 0;
      font-size: 12px;
      font-style: italic;
    }

    .date {
      font-size: 11px;
      white-space: nowrap;
      font-style: italic;
    }

    /* -------- BULLETS -------- */

    .bullets {
      margin: 4px 0 0 16px;
      padding: 0;
      list-style-type: disc;
    }

    .bullets li {
      margin-bottom: 2px;
      line-height: 1.3;
    }

    /* -------- PROJECT SPECIFIC -------- */

    .proj-role {
      font-size: 12px;
      margin: 0 0 2px 0;
    }
    
    .proj-tech-stack {
      font-size: 11px;
      margin: 4px 0 0 0;
      line-height: 1.4;
    }

  </style>
</head>

<body>
<div class="resume">

  <!-- ================= HEADER ================= -->
  <header class="header no-break">
    <h1 class="name">{{personal.firstName}} {{personal.lastName}}</h1>

    {{#if personal.headline}}
    <p class="headline">{{personal.headline}}</p>
    {{/if}}

    <div class="contact">
      {{#if personal.email}} <span>{{personal.email}}</span> {{/if}}
      {{#if personal.phone}} <span>{{personal.phone}}</span> {{/if}}
      {{#if personal.location}} <span>{{personal.location}}</span> {{/if}}
      {{#if personal.linkedin}} <span>LinkedIn</span> {{/if}}
      {{#if personal.github}} <span>GitHub</span> {{/if}}
    </div>
  </header>


  <!-- ================= SUMMARY ================= -->
  {{#if personal.summary}}
  <section class="section">
    <h2 class="section-title">Professional Summary</h2>
    <p class="text">{{personal.summary}}</p>
  </section>
  {{/if}}


  <!-- ================= EXPERIENCE ================= -->
  {{#if experiences.length}}
  <section class="section">
    <h2 class="section-title">Professional Experience</h2>

    {{#each experiences}}
    <div class="item no-break">

      <div class="item-row">
        <div>
          <h3 class="item-title">{{title}}</h3>
          {{#if company}}
          <p class="company">{{company}}</p>
          {{/if}}
        </div>

        <div class="date">
          {{startDate}}
          –
          {{#if isCurrent}}Present{{else}}{{endDate}}{{/if}}
        </div>
      </div>

      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

    </div>
    {{/each}}
  </section>
  {{/if}}



  <!-- ================= EDUCATION ================= -->
  {{#if educations.length}}
  <section class="section">
    <h2 class="section-title">Education</h2>

    {{#each educations}}
    <div class="item no-break">

      <div class="item-row">
        <div>
          <h3 class="item-title">
            {{degree}}
            {{#if major}}
              in {{major}}
            {{/if}}
          </h3>
          <p class="company">{{institution}}</p>
          {{#if gpa}}<p class="small">GPA: {{gpa}}</p>{{/if}}
        </div>

        <div class="date">
          {{startDate}}
          –
          {{#if isCurrent}}Present{{else}}{{endDate}}{{/if}}
        </div>
      </div>

      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

    </div>
    {{/each}}
  </section>
  {{/if}}



  <!-- ================= SKILLS (Updated for SkillCategory structure) ================= -->
  {{#if skills.length}}
  <section class="section">
    <h2 class="section-title">Skills & Expertise</h2>

    {{#each skills}}
    <div class="skill-category no-break">
        <span class="skill-category-name">{{name}}: </span>
        <ul class="skill-list">
        {{#each skills}}
            <li>{{this}}</li>
        {{/each}}
        </ul>
    </div>
    {{/each}}
  </section>
  {{/if}}



  <!-- ================= PROJECTS ================= -->
  {{#if projects.length}}
  <section class="section">
    <h2 class="section-title">Selected Projects</h2>

    {{#each projects}}
    <div class="item no-break">

      <div class="item-row">
        <div>
          <h3 class="item-title">{{title}}</h3>
          {{#if role}}
          <p class="proj-role">{{role}}</p>
          {{/if}}
        </div>
        
        <div class="date">
          {{startDate}}
          –
          {{#if isCurrent}}Present{{else}}{{endDate}}{{/if}}
        </div>
      </div>
      
      {{#if link}}
      <p class="link">{{link}}</p>
      {{/if}}

      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
      {{/if}}

      {{#if techStack.length}}
      <p class="proj-tech-stack small">
        <strong>Technologies:</strong>
        {{#each techStack}}
          {{this}}{{#unless @last}}, {{/unless}}
        {{/each}}
      </p>
      {{/if}}

    </div>
    {{/each}}
  </section>
  {{/if}}

</div>
</body>

</html>