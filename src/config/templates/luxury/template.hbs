<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <style>
    @page { margin: 0; size: A4; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-size: 10pt;
      line-height: calc(1.5 * var(--rr-line-height-mul, 1));
      color: var(--rr-ink);
      background: var(--rr-bg);
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .frame {
      border: 1pt solid var(--rr-border);
      padding: 14pt 16pt;
      min-height: 0;
    }
    .header {
      text-align: center;
      padding-bottom: 16pt;
      margin-bottom: 18pt;
      border-bottom: 1pt solid var(--rr-border);
    }
    .name {
      font-size: 28pt;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--rr-heading);
      margin-bottom: 6pt;
    }
    .headline {
      font-size: 11pt;
      font-style: italic;
      font-weight: 500;
      color: var(--rr-muted);
      margin-bottom: 12pt;
    }
    .contact {
      font-size: 9pt;
      color: var(--rr-muted);
      font-weight: 400;
      letter-spacing: 0.04em;
    }
    .contact span:not(:last-child)::after {
      content: '  ·  ';
      color: var(--rr-border);
      font-weight: 300;
    }
    .section { margin-bottom: calc(16pt * var(--rr-section-gap-mul, 1)); page-break-inside: avoid; }
    .section-title {
      font-size: 10pt;
      font-weight: var(--rr-heading-weight, 700);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--rr-heading);
      text-align: center;
      margin-bottom: 12pt;
      padding-bottom: 8pt;
      border-bottom: 1pt solid var(--rr-border);
    }
    .summary {
      text-align: justify;
      color: var(--rr-ink);
      font-size: 10pt;
      line-height: 1.6;
      padding: 0 4pt;
    }
    .entry { margin-bottom: 14pt; page-break-inside: avoid; }
    .entry-head {
      display: flex;
      justify-content: space-between;
      gap: 14pt;
      align-items: baseline;
      margin-bottom: 5pt;
    }
    .entry-title { font-weight: 600; font-size: 11pt; color: var(--rr-heading); }
    .entry-sub { font-size: 9.5pt; color: var(--rr-muted); font-style: italic; margin-top: 3pt; }
    .entry-date { font-size: 9pt; color: var(--rr-muted); white-space: nowrap; font-weight: 500; }
    ul.bullets {
      list-style: none;
      margin: 6pt 0 0 0;
      padding: 0;
    }
    ul.bullets li {
      position: relative;
      padding-left: 14pt;
      margin-bottom: 5pt;
      font-size: 9.5pt;
      color: var(--rr-ink);
      line-height: 1.5;
      text-align: justify;
    }
    ul.bullets li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--rr-muted);
      font-weight: 300;
    }
    .skills-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12pt 20pt;
    }
    .skill-card {
      text-align: center;
      padding: 10pt 8pt;
      border: 1pt solid var(--rr-border);
    }
    .skill-card .lab {
      font-size: 8.5pt;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--rr-heading);
      margin-bottom: 6pt;
      padding-bottom: 6pt;
      border-bottom: 1pt solid var(--rr-border);
    }
    .skill-card .vals { font-size: 9pt; color: var(--rr-muted); line-height: 1.55; }
    .tech {
      font-size: 8.75pt;
      color: var(--rr-muted);
      margin-top: 6pt;
      padding-top: 6pt;
      border-top: 1pt solid var(--rr-border);
      font-style: italic;
    }
  </style>
</head>
<body class="rr-resume">
  <div class="frame">

    <header class="header">
      <div class="name">{{personal.firstName}} {{personal.lastName}}</div>
      {{#if personal.headline}}<div class="headline">{{personal.headline}}</div>{{/if}}
      <div class="contact">
        {{#if personal.email}}<span>{{personal.email}}</span>{{/if}}
        {{#if personal.phone}}<span>{{personal.phone}}</span>{{/if}}
        {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
        {{#if personal.linkedin}}<span><a href="{{hrefUrl personal.linkedin}}">LinkedIn</a></span>{{/if}}
        {{#if personal.portfolioUrl}}<span><a href="{{hrefUrl personal.portfolioUrl}}">Portfolio</a></span>{{/if}}
        {{#if personal.github}}<span><a href="{{hrefUrl personal.github}}">GitHub</a></span>{{/if}}
      </div>
    </header>

    {{#each sectionOrder}}
      {{#if (eq this "summary")}}
        {{#if @root.personal.summary}}
        <section class="section">
          <div class="section-title">Profile</div>
          <div class="summary" data-rr-field="personal.summary">{{{fmt @root.personal.summary}}}</div>
        </section>
        {{/if}}
      {{/if}}
      {{#if (eq this "experience")}}
        {{#if @root.experiences.length}}
        <section class="section" data-rr-field="section.experience">
          <div class="section-title">Experience</div>
          {{#each @root.experiences}}
          <div class="entry">
            <div class="entry-head">
              <div>
                <div class="entry-title">{{title}}</div>
                <div class="entry-sub">
                  {{#if company}}{{company}}{{/if}}
                </div>
              </div>
              <div class="entry-date">
                {{#if startDate}}{{formatDate startDate}}{{/if}}
                {{#if isCurrent}} — Present{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
              </div>
            </div>
            {{#if role}}<div class="entry-sub">{{role}}</div>{{/if}}
            {{#if bullets.length}}
            <ul class="bullets">
              {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
            </ul>
            {{/if}}
          </div>
          {{/each}}
        </section>
        {{/if}}
      {{/if}}
      {{#if (eq this "education")}}
        {{#if @root.educations.length}}
        <section class="section" data-rr-field="section.education">
          <div class="section-title">Education</div>
          {{#each @root.educations}}
          <div class="entry">
            <div class="entry-head">
              <div>
                <div class="entry-title">{{institution}}</div>
                <div class="entry-sub">{{degree}}{{#if major}} in {{major}}{{/if}}{{#if gpa}} · {{gpa}}{{/if}}</div>
              </div>
              <div class="entry-date">
                {{#if startDate}}{{formatDate startDate}}{{/if}}
                {{#if isCurrent}} — Present{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
              </div>
            </div>
            {{#if bullets.length}}
            <ul class="bullets">
              {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
            </ul>
            {{/if}}
          </div>
          {{/each}}
        </section>
        {{/if}}
      {{/if}}
      {{#if (eq this "projects")}}
        {{#if @root.projects.length}}
        <section class="section" data-rr-field="section.projects">
          <div class="section-title">Selected projects</div>
          {{#each @root.projects}}
          <div class="entry">
            <div class="entry-head">
              <div class="entry-title">{{title}}{{#if link}} · <a href="{{link}}">link</a>{{/if}}</div>
              <div class="entry-date">
                {{#if startDate}}{{formatDate startDate}}{{/if}}
                {{#if isCurrent}} — Present{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
              </div>
            </div>
            {{#if role}}<div class="entry-sub">{{role}}</div>{{/if}}
            {{#if techStack.length}}
            <div class="tech">{{#each techStack}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
            {{/if}}
            {{#if bullets.length}}
            <ul class="bullets">
              {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
            </ul>
            {{/if}}
          </div>
          {{/each}}
        </section>
        {{/if}}
      {{/if}}
      {{#if (eq this "skills")}}
        {{#if @root.skills.length}}
        <section class="section" data-rr-field="section.skills">
          <div class="section-title">Expertise</div>
          <div class="skills-grid">
            {{#each @root.skills}}
            <div class="skill-card">
              <div class="lab">{{{fmt name}}}</div>
              <div class="vals">{{#each skills}}{{{fmt this}}}{{#unless @last}}, {{/unless}}{{/each}}</div>
            </div>
            {{/each}}
          </div>
        </section>
        {{/if}}
      {{/if}}
    {{/each}}

  </div>
</body>
</html>
