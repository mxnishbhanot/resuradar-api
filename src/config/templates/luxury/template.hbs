<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Infant:ital,wght@0,500;0,600;1,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    @page { margin: 0; size: A4; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', 'Segoe UI', sans-serif;
      font-size: 10pt;
      line-height: 1.5;
      color: #292524;
      background: #fff;
      padding: 11mm 15mm;
      max-width: 210mm;
      margin: 0 auto;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .frame {
      border: 1pt solid #d6d3d1;
      padding: 14pt 16pt;
      min-height: 0;
    }
    .header {
      text-align: center;
      padding-bottom: 16pt;
      margin-bottom: 18pt;
      border-bottom: 1pt solid #c4a574;
    }
    .name {
      font-family: 'Cormorant Infant', 'Times New Roman', serif;
      font-size: 34pt;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: #1c1917;
      margin-bottom: 6pt;
    }
    .headline {
      font-family: 'Cormorant Infant', serif;
      font-size: 12pt;
      font-style: italic;
      font-weight: 500;
      color: #78716c;
      margin-bottom: 12pt;
    }
    .contact {
      font-size: 9pt;
      color: #78716c;
      font-weight: 400;
      letter-spacing: 0.06em;
    }
    .contact span:not(:last-child)::after {
      content: '  ·  ';
      color: #c4a574;
      font-weight: 300;
    }
    .section { margin-bottom: 16pt; page-break-inside: avoid; }
    .section-title {
      font-family: 'Cormorant Infant', serif;
      font-size: 12pt;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #44403c;
      text-align: center;
      margin-bottom: 12pt;
      padding-bottom: 8pt;
      border-bottom: 1pt solid #e7e5e4;
    }
    .summary {
      text-align: justify;
      color: #44403c;
      font-size: 10pt;
      line-height: 1.6;
      padding: 0 4pt;
    }
    .entry { margin-bottom: 14pt; page-break-inside: avoid; }
    .entry-head {
      display: flex;
      justify-content: space-between;
      gap: 14pt;
      align-items: baseline;
      margin-bottom: 5pt;
    }
    .entry-title { font-weight: 600; font-size: 11pt; color: #1c1917; }
    .entry-sub { font-size: 9.5pt; color: #78716c; font-style: italic; margin-top: 3pt; }
    .entry-date { font-size: 9pt; color: #a8a29e; white-space: nowrap; font-weight: 500; }
    ul.bullets {
      list-style: none;
      margin: 6pt 0 0 0;
      padding: 0;
    }
    ul.bullets li {
      position: relative;
      padding-left: 14pt;
      margin-bottom: 5pt;
      font-size: 9.5pt;
      color: #44403c;
      line-height: 1.5;
      text-align: justify;
    }
    ul.bullets li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: #c4a574;
      font-weight: 300;
    }
    .skills-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12pt 20pt;
    }
    .skill-card {
      text-align: center;
      padding: 10pt 8pt;
      border: 1pt solid #e7e5e4;
    }
    .skill-card .lab {
      font-size: 8.5pt;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #292524;
      margin-bottom: 6pt;
      padding-bottom: 6pt;
      border-bottom: 1pt solid #c4a574;
    }
    .skill-card .vals { font-size: 9pt; color: #57534e; line-height: 1.55; }
    .tech {
      font-size: 8.75pt;
      color: #78716c;
      margin-top: 6pt;
      padding-top: 6pt;
      border-top: 1pt solid #f5f5f4;
      font-style: italic;
    }
    a { color: #854d0e; text-decoration: none; font-weight: 500; border-bottom: 0.5pt solid #d6d3d1; }
  </style>
</head>
<body>
  <div class="frame">

    <header class="header">
      <div class="name">{{personal.firstName}} {{personal.lastName}}</div>
      {{#if personal.headline}}<div class="headline">{{personal.headline}}</div>{{/if}}
      <div class="contact">
        {{#if personal.email}}<span>{{personal.email}}</span>{{/if}}
        {{#if personal.phone}}<span>{{personal.phone}}</span>{{/if}}
        {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
      </div>
    </header>

    {{#if personal.summary}}
    <section class="section">
      <div class="section-title">Profile</div>
      <div class="summary">{{personal.summary}}</div>
    </section>
    {{/if}}

    {{#if experiences.length}}
    <section class="section">
      <div class="section-title">Experience</div>
      {{#each experiences}}
      <div class="entry">
        <div class="entry-head">
          <div>
            <div class="entry-title">{{title}}</div>
            <div class="entry-sub">
              {{#if company}}{{company}}{{/if}}
            </div>
          </div>
          <div class="entry-date">
            {{#if startDate}}{{formatDate startDate}}{{/if}}
            {{#if isCurrent}} — Present{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
          </div>
        </div>
        {{#if role}}<div class="entry-sub">{{role}}</div>{{/if}}
        {{#if bullets.length}}
        <ul class="bullets">
          {{#each bullets}}<li>{{this}}</li>{{/each}}
        </ul>
        {{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if educations.length}}
    <section class="section">
      <div class="section-title">Education</div>
      {{#each educations}}
      <div class="entry">
        <div class="entry-head">
          <div>
            <div class="entry-title">{{institution}}</div>
            <div class="entry-sub">{{degree}}{{#if major}} in {{major}}{{/if}}{{#if gpa}} · {{gpa}}{{/if}}</div>
          </div>
          <div class="entry-date">
            {{#if startDate}}{{formatDate startDate}}{{/if}}
            {{#if isCurrent}} — Present{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
          </div>
        </div>
        {{#if bullets.length}}
        <ul class="bullets">
          {{#each bullets}}<li>{{this}}</li>{{/each}}
        </ul>
        {{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if projects.length}}
    <section class="section">
      <div class="section-title">Selected projects</div>
      {{#each projects}}
      <div class="entry">
        <div class="entry-head">
          <div class="entry-title">{{title}}{{#if link}} · <a href="{{link}}">link</a>{{/if}}</div>
          <div class="entry-date">
            {{#if startDate}}{{formatDate startDate}}{{/if}}
            {{#if isCurrent}} — Present{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
          </div>
        </div>
        {{#if role}}<div class="entry-sub">{{role}}</div>{{/if}}
        {{#if techStack.length}}
        <div class="tech">{{#each techStack}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
        {{/if}}
        {{#if bullets.length}}
        <ul class="bullets">
          {{#each bullets}}<li>{{this}}</li>{{/each}}
        </ul>
        {{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if skills.length}}
    <section class="section">
      <div class="section-title">Expertise</div>
      <div class="skills-grid">
        {{#each skills}}
        <div class="skill-card">
          <div class="lab">{{name}}</div>
          <div class="vals">{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}

  </div>
</body>
</html>
