<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    @page { margin: 0; size: A4; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Source Sans 3', 'Segoe UI', sans-serif;
      font-size: 10.25pt;
      line-height: 1.48;
      color: #1c1917;
      background: #fff;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .header {
      text-align: center;
      padding-bottom: 14pt;
      margin-bottom: 16pt;
      border-bottom: 1pt solid #a8a29e;
    }
    .name {
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-size: 32pt;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #292524;
      margin-bottom: 6pt;
    }
    .headline {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 12pt;
      font-style: italic;
      color: #57534e;
      margin-bottom: 12pt;
    }
    .contact {
      font-size: 9.25pt;
      color: #78716c;
      font-weight: 500;
      letter-spacing: 0.04em;
    }
    .contact span:not(:last-child)::after {
      content: ' · ';
      color: #d6d3d1;
    }
    .section { margin-bottom: calc(15pt * var(--rr-section-gap-mul, 1)); page-break-inside: avoid; }
    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 13pt;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #44403c;
      text-align: center;
      margin-bottom: 12pt;
      padding-bottom: 6pt;
      border-bottom: 1pt solid #e7e5e4;
    }
    .summary {
      text-align: justify;
      color: #44403c;
      max-width: 100%;
      font-size: 10pt;
    }
    .entry { margin-bottom: 12pt; page-break-inside: avoid; }
    .entry-head {
      display: flex;
      justify-content: space-between;
      gap: 12pt;
      align-items: baseline;
      margin-bottom: 4pt;
    }
    .entry-title { font-weight: 700; font-size: 10.75pt; color: #1c1917; }
    .entry-co { font-weight: 600; font-size: 10.25pt; color: #44403c; margin-top: 2pt; }
    .entry-date { font-size: 9pt; color: #78716c; white-space: nowrap; font-weight: 600; }
    ul.bullets {
      list-style: none;
      margin: 6pt 0 0 0;
      padding: 0;
    }
    ul.bullets li {
      position: relative;
      padding-left: 12pt;
      margin-bottom: 4pt;
      font-size: 9.75pt;
      color: #44403c;
      line-height: 1.45;
    }
    ul.bullets li::before {
      content: '·';
      position: absolute;
      left: 0;
      font-weight: 700;
      color: #a8a29e;
    }
    .skills-wrap { column-count: 2; column-gap: 18pt; }
    .skill-row { break-inside: avoid; margin-bottom: 8pt; }
    .skill-row strong { font-size: 9.5pt; color: #292524; display: block; margin-bottom: 2pt; }
    .skill-row span { font-size: 9pt; color: #57534e; }
    .tech { font-size: 8.75pt; color: #78716c; margin-top: 4pt; font-style: italic; }
    a { color: #57534e; text-decoration: underline; text-underline-offset: 2pt; }
  </style>
</head>
<body>

  <header class="header">
    <div class="name">{{personal.firstName}} {{personal.lastName}}</div>
    {{#if personal.headline}}<div class="headline">{{personal.headline}}</div>{{/if}}
    <div class="contact">
      {{#if personal.email}}<span>{{personal.email}}</span>{{/if}}
      {{#if personal.phone}}<span>{{personal.phone}}</span>{{/if}}
      {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
      {{#if personal.linkedin}}<span><a href="{{hrefUrl personal.linkedin}}">LinkedIn</a></span>{{/if}}
      {{#if personal.portfolioUrl}}<span><a href="{{hrefUrl personal.portfolioUrl}}">Portfolio</a></span>{{/if}}
      {{#if personal.github}}<span><a href="{{hrefUrl personal.github}}">GitHub</a></span>{{/if}}
    </div>
  </header>

  {{#each sectionOrder}}
    {{#if (eq this "summary")}}
      {{#if @root.personal.summary}}
      <section class="section">
        <div class="section-title">Profile</div>
        <div class="summary" data-rr-field="personal.summary">{{@root.personal.summary}}</div>
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "experience")}}
      {{#if @root.experiences.length}}
      <section class="section" data-rr-field="section.experience">
        <div class="section-title">Experience</div>
        {{#each @root.experiences}}
        <div class="entry">
          <div class="entry-head">
            <div>
              <div class="entry-title">{{title}}</div>
              {{#if company}}<div class="entry-co">{{company}}</div>{{/if}}
            </div>
            <div class="entry-date">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} — Present{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
            </div>
          </div>
          {{#if role}}<div class="entry-co" style="font-weight:500;font-style:italic;">{{role}}</div>{{/if}}
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{this}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "education")}}
      {{#if @root.educations.length}}
      <section class="section" data-rr-field="section.education">
        <div class="section-title">Education</div>
        {{#each @root.educations}}
        <div class="entry">
          <div class="entry-head">
            <div>
              <div class="entry-title">{{institution}}</div>
              <div class="entry-co">{{degree}}{{#if major}}, {{major}}{{/if}}{{#if gpa}} · {{gpa}}{{/if}}</div>
            </div>
            <div class="entry-date">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} — Present{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
            </div>
          </div>
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{this}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "projects")}}
      {{#if @root.projects.length}}
      <section class="section" data-rr-field="section.projects">
        <div class="section-title">Selected work</div>
        {{#each @root.projects}}
        <div class="entry">
          <div class="entry-head">
            <div class="entry-title">{{title}}{{#if link}} — <a href="{{link}}">link</a>{{/if}}</div>
            <div class="entry-date">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} — Present{{else}}{{#if endDate}} — {{formatDate endDate}}{{/if}}{{/if}}
            </div>
          </div>
          {{#if role}}<div class="entry-co">{{role}}</div>{{/if}}
          {{#if techStack.length}}<div class="tech">{{#each techStack}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{this}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "skills")}}
      {{#if @root.skills.length}}
      <section class="section" data-rr-field="section.skills">
        <div class="section-title">Capabilities</div>
        <div class="skills-wrap">
          {{#each @root.skills}}
          <div class="skill-row">
            <strong>{{name}}</strong>
            <span>{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}
    {{/if}}
  {{/each}}

</body>
</html>
