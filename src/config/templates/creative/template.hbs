<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{personal.firstName}} {{personal.lastName}} - Resume</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    @page {
      margin: 0;
      size: letter;
    }

    body {
      font-family: 'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      font-size: 10pt;
      line-height: 1.5;
      color: #334155;
      background: #ffffff;
      padding: 0.5in;
      max-width: 8.5in;
      margin: 0 auto;
    }

    /* Layout */
    .resume-container {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    /* Header */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 20px;
      margin-bottom: 25px;
      border-bottom: 3px solid #14b8a6;
    }

    .header-info {
      flex: 1;
    }

    .header-contact {
      text-align: right;
      font-size: 9pt;
      color: #64748b;
    }

    h1 {
      font-size: 32pt;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -1px;
      margin-bottom: 5px;
      text-transform: uppercase;
    }

    .headline {
      font-size: 14pt;
      font-weight: 500;
      color: #14b8a6;
      letter-spacing: 0.5px;
    }

    .contact-item {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
    }

    /* Grid Layout */
    .content-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 30px;
    }

    /* Section Styles */
    .section {
      margin-bottom: 25px;
    }

    .section-title {
      font-size: 13pt;
      font-weight: 700;
      color: #0f172a;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
    }

    .section-title::before {
      content: '';
      display: inline-block;
      width: 12px;
      height: 12px;
      background-color: #14b8a6;
      margin-right: 10px;
      border-radius: 2px;
      transform: rotate(45deg);
    }

    /* Summary */
    .summary {
      font-size: 10pt;
      line-height: 1.6;
      color: #475569;
    }

    /* Entry */
    .entry {
      margin-bottom: 18px;
    }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 4px;
    }

    .entry-title {
      font-size: 11pt;
      font-weight: 700;
      color: #0f172a;
    }

    .entry-company, .entry-link {
      font-size: 10pt;
      font-weight: 600;
      color: #14b8a6;
    }

    .entry-date {
      font-size: 9pt;
      font-weight: 500;
      color: #94a3b8;
      background: #f8fafc;
      padding: 2px 8px;
      border-radius: 4px;
    }

    .entry-date.current {
      color: #0d9488;
      background: #ccfbf1;
    }

    .entry-bullets {
      margin-top: 8px;
      margin-left: 15px;
      list-style-type: none;
    }

    .entry-bullets li {
      position: relative;
      margin-bottom: 5px;
      font-size: 9.5pt;
      color: #475569;
      line-height: 1.5;
    }

    .entry-bullets li::before {
      content: '→';
      position: absolute;
      left: -15px;
      color: #14b8a6;
      font-weight: bold;
    }

    /* Tags for skills / tech stack */
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
    }

    .tag {
      background-color: #f1f5f9;
      color: #334155;
      font-size: 8.5pt;
      font-weight: 500;
      padding: 3px 8px;
      border-radius: 6px;
      border: 1px solid #e2e8f0;
    }

    /* Skills column */
    .skill-category {
      margin-bottom: 15px;
    }

    .skill-name {
      font-weight: 700;
      color: #0f172a;
      font-size: 10pt;
      margin-bottom: 6px;
    }
  </style>
</head>
<body>
  <div class="resume-container">
    <div class="header">
      <div class="header-info">
        <h1>{{personal.firstName}} {{personal.lastName}}</h1>
        {{#if personal.headline}}
          <div class="headline">{{personal.headline}}</div>
        {{/if}}
      </div>
      <div class="header-contact">
        {{#if personal.email}}
          <div class="contact-item"><span>{{personal.email}}</span> ✉</div>
        {{/if}}
        {{#if personal.phone}}
          <div class="contact-item"><span>{{personal.phone}}</span> ☎</div>
        {{/if}}
        {{#if personal.location}}
          <div class="contact-item"><span>{{personal.location}}</span> 📍</div>
        {{/if}}
      </div>
    </div>

    <div class="content-grid">
      <!-- Main Content (Left) -->
      <div class="main-column">
        {{#if personal.summary}}
        <div class="section">
          <div class="section-title">Profile</div>
          <div class="summary">{{personal.summary}}</div>
        </div>
        {{/if}}

        {{#if experiences.length}}
        <div class="section">
          <div class="section-title">Experience</div>
          {{#each experiences}}
            <div class="entry">
              <div class="entry-header">
                <div>
                  <span class="entry-title">{{title}}</span>
                  {{#if company}}
                    <span style="margin: 0 5px; color: #cbd5e1;">|</span>
                    <span class="entry-company">{{company}}</span>
                  {{/if}}
                </div>
                <div class="entry-date {{#if isCurrent}}current{{/if}}">
                  {{#if startDate}}{{formatDate startDate "MMM YYYY"}}{{/if}}
                  {{#if isCurrent}} – Present
                  {{else}} {{#if endDate}} – {{formatDate endDate "MMM YYYY"}}{{/if}}
                  {{/if}}
                </div>
              </div>
              {{#if bullets.length}}
                <ul class="entry-bullets">
                  {{#each bullets}}
                    <li>{{this}}</li>
                  {{/each}}
                </ul>
              {{/if}}
            </div>
          {{/each}}
        </div>
        {{/if}}

        {{#if projects.length}}
        <div class="section">
          <div class="section-title">Projects</div>
          {{#each projects}}
            <div class="entry">
              <div class="entry-header">
                <div>
                  <span class="entry-title">{{title}}</span>
                  {{#if link}}
                    <span style="margin: 0 5px;">-</span>
                    <a href="{{link}}" class="entry-link" style="text-decoration:none;">{{link}}</a>
                  {{/if}}
                </div>
                <div class="entry-date">
                  {{#if startDate}}{{formatDate startDate "MMM YYYY"}}{{/if}}
                  {{#if isCurrent}} – Present
                  {{else}} {{#if endDate}} – {{formatDate endDate "MMM YYYY"}}{{/if}}
                  {{/if}}
                </div>
              </div>
              {{#if techStack.length}}
                <div class="tags" style="margin-bottom: 6px;">
                  {{#each techStack}}<span class="tag">{{this}}</span>{{/each}}
                </div>
              {{/if}}
              {{#if bullets.length}}
                <ul class="entry-bullets">
                  {{#each bullets}}
                    <li>{{this}}</li>
                  {{/each}}
                </ul>
              {{/if}}
            </div>
          {{/each}}
        </div>
        {{/if}}
      </div>

      <!-- Side Content (Right) -->
      <div class="side-column">
        {{#if skills.length}}
        <div class="section">
          <div class="section-title">Expertise</div>
          {{#each skills}}
            <div class="skill-category">
              <div class="skill-name">{{name}}</div>
              <div class="tags">
                {{#each skills}}<span class="tag" style="background:#e0f2fe; color:#0369a1; border-color:#bae6fd;">{{this}}</span>{{/each}}
              </div>
            </div>
          {{/each}}
        </div>
        {{/if}}

        {{#if educations.length}}
        <div class="section">
          <div class="section-title">Education</div>
          {{#each educations}}
            <div class="entry" style="margin-bottom: 15px;">
              <div class="entry-title" style="font-size: 10pt;">{{degree}} {{#if major}}in {{major}}{{/if}}</div>
              <div style="font-size: 9.5pt; color: #475569; margin-top: 2px;">{{institution}}</div>
              <div class="entry-date" style="display: inline-block; margin-top: 4px; font-size: 8pt;">
                {{#if startDate}}{{formatDate startDate "YYYY"}}{{/if}}
                {{#if isCurrent}} – Present
                {{else}} {{#if endDate}} – {{formatDate endDate "YYYY"}}{{/if}}
                {{/if}}
              </div>
              {{#if gpa}}
                <div style="font-size: 8.5pt; color: #64748b; margin-top: 2px;">GPA: {{gpa}}</div>
              {{/if}}
            </div>
          {{/each}}
        </div>
        {{/if}}
      </div>
    </div>
  </div>
</body>
</html>
