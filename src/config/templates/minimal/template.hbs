<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <style>
    body {
      font-family: Arial, sans-serif;
      color: #222;
      margin: 0;
      padding: 28px;
      line-height: 1.35;
      font-size: 12px;
    }
    h1, h2, h3 {
      margin: 0;
      font-weight: 600;
    }
    h1 { font-size: 20px; }
    h2 { font-size: 14px; margin-top: 18px; border-bottom: 1px solid #ddd; padding-bottom: 4px; }
    h3 { font-size: 12px; }

    .section { margin-top: 14px; }
    .item { margin-bottom: 10px; }
    .sub { color: #555; font-size: 11px; }
    .flex { display: flex; justify-content: space-between; }
    .tech-stack { font-size: 11px; color: #444; margin-top: 2px; }
    ul { padding-left: 18px; margin: 4px 0; }
    a { color: #0066cc; text-decoration: none; }
  </style>
</head>

<body>

  {{!-- ===========================
       HEADER
  ============================ --}}
  <header>
    {{#if personal.firstName}}
    <h1>{{personal.firstName}} {{personal.lastName}}</h1>
    {{/if}}

    {{#if personal.headline}}
      <div class="sub">{{personal.headline}}</div>
    {{/if}}

    <div class="sub">
      {{#if personal.email}}{{personal.email}} · {{/if}}
      {{#if personal.phone}}{{personal.phone}} · {{/if}}
      {{#if personal.location}}{{personal.location}}{{/if}}
    </div>
  </header>

  {{!-- ===========================
       SUMMARY
  ============================ --}}
  {{#if personal.summary}}
  <div class="section">
    <h2>Professional Summary</h2>
    <div>{{personal.summary}}</div>
  </div>
  {{/if}}

  {{!-- ===========================
       SKILLS (Skill Categories)
  ============================ --}}
  {{#if skills.length}}
  <div class="section">
    <h2>Skills</h2>
    {{#each skills}}
      <div class="item">
        <strong>{{name}}</strong>: {{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
      </div>
    {{/each}}
  </div>
  {{/if}}

  {{!-- ===========================
       EXPERIENCE
  ============================ --}}
  {{#if experiences.length}}
  <div class="section">
    <h2>Experience</h2>
    {{#each experiences}}
      <div class="item">
        <div class="flex">
          <strong>{{title}}</strong>
          <div class="sub">
            {{#if isCurrent}}
              {{formatDate startDate "MMM YYYY"}} – Present
            {{else}}
              {{formatDate startDate "MMM YYYY"}} – {{formatDate endDate "MMM YYYY"}}
            {{/if}}
          </div>
        </div>

        {{#if company}}
          <div class="sub">{{company}}</div>
        {{/if}}

        {{#if link}}
          <div class="sub"><a href="{{link}}">{{link}}</a></div>
        {{/if}}

        {{#if bullets.length}}
          <ul>
            {{#each bullets}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}
      </div>
    {{/each}}
  </div>
  {{/if}}

  {{!-- ===========================
       PROJECTS
  ============================ --}}
  {{#if projects.length}}
  <div class="section">
    <h2>Projects</h2>
    {{#each projects}}
      <div class="item">

        <div class="flex">
          <strong>{{title}}</strong>
          <div class="sub">
            {{#if isCurrent}}
              {{formatDate startDate "MMM YYYY"}} – Present
            {{else}}
              {{formatDate startDate "MMM YYYY"}} – {{formatDate endDate "MMM YYYY"}}
            {{/if}}
          </div>
        </div>

        {{#if role}}
          <div class="sub">{{role}}</div>
        {{/if}}

        {{#if link}}
          <div class="sub"><a href="{{link}}">{{link}}</a></div>
        {{/if}}

        {{#if techStack.length}}
          <div class="tech-stack"><strong>Tech:</strong> {{#each techStack}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
        {{/if}}

        {{#if bullets.length}}
          <ul>
            {{#each bullets}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}

      </div>
    {{/each}}
  </div>
  {{/if}}

  {{!-- ===========================
       EDUCATION
  ============================ --}}
  {{#if educations.length}}
  <div class="section">
    <h2>Education</h2>
    {{#each educations}}
      <div class="item">
        <strong>{{degree}}, {{major}}</strong>

        <div class="sub">{{institution}}</div>

        <div class="sub">
          {{#if isCurrent}}
            {{formatDate startDate "MMM YYYY"}} – Present
          {{else}}
            {{formatDate startDate "MMM YYYY"}} – {{formatDate endDate "MMM YYYY"}}
          {{/if}}
          {{#if gpa}} · GPA: {{gpa}}{{/if}}
        </div>

        {{#if bullets.length}}
          <ul>
            {{#each bullets}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}

      </div>
    {{/each}}
  </div>
  {{/if}}

</body>
</html>
