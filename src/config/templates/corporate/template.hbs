<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    @page { margin: 0; size: A4; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Plus Jakarta Sans', 'Segoe UI', system-ui, sans-serif;
      font-size: 10pt;
      line-height: 1.45;
      color: #0f172a;
      background: #fff;
      padding: 10mm 14mm;
      max-width: 210mm;
      margin: 0 auto;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .masthead {
      border-bottom: 3pt solid #1e3a5f;
      padding-bottom: 12pt;
      margin-bottom: 14pt;
    }
    .name {
      font-family: 'Libre Baskerville', Georgia, serif;
      font-size: 22pt;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: #1e3a5f;
      margin-bottom: 4pt;
    }
    .headline {
      font-size: 10.5pt;
      font-weight: 500;
      color: #475569;
      margin-bottom: 10pt;
    }
    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 6pt 14pt;
      font-size: 9pt;
      color: #64748b;
      font-weight: 500;
    }
    .contact span { white-space: nowrap; }
    .section { margin-bottom: 13pt; page-break-inside: avoid; }
    .section-title {
      font-size: 9.5pt;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #1e3a5f;
      border-bottom: 0.75pt solid #cbd5e1;
      padding-bottom: 4pt;
      margin-bottom: 8pt;
    }
    .summary {
      font-size: 10pt;
      line-height: 1.5;
      color: #334155;
      text-align: justify;
    }
    .skills-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6pt 16pt;
    }
    .skill-block strong {
      display: block;
      font-size: 9.5pt;
      color: #0f172a;
      margin-bottom: 2pt;
    }
    .skill-block span { font-size: 9pt; color: #475569; }
    .entry { margin-bottom: 10pt; page-break-inside: avoid; }
    .entry-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10pt;
      margin-bottom: 3pt;
    }
    .entry-title { font-size: 10.5pt; font-weight: 700; color: #0f172a; }
    .entry-sub { font-size: 9.5pt; color: #475569; font-style: italic; margin-bottom: 4pt; }
    .entry-date {
      font-size: 9pt;
      font-weight: 600;
      color: #1e3a5f;
      white-space: nowrap;
    }
    ul.bullets {
      margin: 4pt 0 0 14pt;
      padding: 0;
    }
    ul.bullets li {
      font-size: 9.5pt;
      line-height: 1.45;
      color: #334155;
      margin-bottom: 3pt;
    }
    .tech {
      font-size: 8.5pt;
      color: #64748b;
      margin-top: 4pt;
      font-weight: 500;
    }
    a { color: #1e3a5f; text-decoration: none; }
  </style>
</head>
<body>

  <header class="masthead">
    <div class="name">{{personal.firstName}} {{personal.lastName}}</div>
    {{#if personal.headline}}<div class="headline">{{personal.headline}}</div>{{/if}}
    <div class="contact">
      {{#if personal.email}}<span>{{personal.email}}</span>{{/if}}
      {{#if personal.phone}}<span>{{personal.phone}}</span>{{/if}}
      {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
    </div>
  </header>

  {{#if personal.summary}}
  <section class="section">
    <div class="section-title">Executive summary</div>
    <div class="summary">{{personal.summary}}</div>
  </section>
  {{/if}}

  {{#if experiences.length}}
  <section class="section">
    <div class="section-title">Professional experience</div>
    {{#each experiences}}
    <div class="entry">
      <div class="entry-head">
        <div>
          <div class="entry-title">{{title}}{{#if company}} — {{company}}{{/if}}</div>
          {{#if role}}<div class="entry-sub">{{role}}</div>{{/if}}
        </div>
        <div class="entry-date">
          {{#if startDate}}{{formatDate startDate}}{{/if}}
          {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
        </div>
      </div>
      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}<li>{{this}}</li>{{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if educations.length}}
  <section class="section">
    <div class="section-title">Education</div>
    {{#each educations}}
    <div class="entry">
      <div class="entry-head">
        <div>
          <div class="entry-title">{{degree}}{{#if major}} in {{major}}{{/if}}</div>
          <div class="entry-sub">{{institution}}{{#if gpa}} · GPA {{gpa}}{{/if}}</div>
        </div>
        <div class="entry-date">
          {{#if startDate}}{{formatDate startDate}}{{/if}}
          {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
        </div>
      </div>
      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}<li>{{this}}</li>{{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if projects.length}}
  <section class="section">
    <div class="section-title">Key projects</div>
    {{#each projects}}
    <div class="entry">
      <div class="entry-head">
        <div class="entry-title">
          {{title}}
          {{#if link}}<span style="font-weight:500;font-size:9pt;"> · <a href="{{link}}">Link</a></span>{{/if}}
        </div>
        <div class="entry-date">
          {{#if startDate}}{{formatDate startDate}}{{/if}}
          {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
        </div>
      </div>
      {{#if role}}<div class="entry-sub">{{role}}</div>{{/if}}
      {{#if techStack.length}}<div class="tech">{{#each techStack}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</div>{{/if}}
      {{#if bullets.length}}
      <ul class="bullets">
        {{#each bullets}}<li>{{this}}</li>{{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if skills.length}}
  <section class="section">
    <div class="section-title">Core competencies</div>
    <div class="skills-grid">
      {{#each skills}}
      <div class="skill-block">
        <strong>{{name}}</strong>
        <span>{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

</body>
</html>
