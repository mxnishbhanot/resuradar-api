<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{personal.firstName}} {{personal.lastName}}</title>
  <style>
    @page { margin: 0; size: A4; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-size: 10pt;
      line-height: calc(1.45 * var(--rr-line-height-mul, 1));
      color: var(--rr-ink);
      background: var(--rr-bg);
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .masthead {
      border-bottom: 2pt solid var(--rr-border);
      padding-bottom: 12pt;
      margin-bottom: 14pt;
    }
    .name {
      font-size: 22pt;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--rr-heading);
      margin-bottom: 4pt;
    }
    .headline {
      font-size: 10.5pt;
      font-weight: 500;
      color: var(--rr-muted);
      margin-bottom: 10pt;
    }
    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 6pt 14pt;
      font-size: 9pt;
      color: var(--rr-muted);
      font-weight: 500;
    }
    .contact span { white-space: nowrap; }
    .section { margin-bottom: calc(13pt * var(--rr-section-gap-mul, 1)); page-break-inside: avoid; }
    .section-title {
      font-size: 9.5pt;
      font-weight: var(--rr-heading-weight, 700);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--rr-heading);
      border-bottom: 0.75pt solid var(--rr-border);
      padding-bottom: 4pt;
      margin-bottom: 8pt;
    }
    .summary {
      font-size: 10pt;
      line-height: 1.5;
      color: var(--rr-ink);
      text-align: justify;
    }
    .skills-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6pt 16pt;
    }
    .skill-block strong {
      display: block;
      font-size: 9.5pt;
      color: var(--rr-heading);
      margin-bottom: 2pt;
    }
    .skill-block span { font-size: 9pt; color: var(--rr-muted); }
    .entry { margin-bottom: 10pt; page-break-inside: avoid; }
    .entry-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10pt;
      margin-bottom: 3pt;
    }
    .entry-title { font-size: 10.5pt; font-weight: 700; color: var(--rr-heading); }
    .entry-sub { font-size: 9.5pt; color: var(--rr-muted); font-style: italic; margin-bottom: 4pt; }
    .entry-date {
      font-size: 9pt;
      font-weight: 600;
      color: var(--rr-muted);
      white-space: nowrap;
    }
    ul.bullets {
      margin: 4pt 0 0 14pt;
      padding: 0;
    }
    ul.bullets li {
      font-size: 9.5pt;
      line-height: 1.45;
      color: var(--rr-ink);
      margin-bottom: 3pt;
    }
    .tech {
      font-size: 8.5pt;
      color: var(--rr-muted);
      margin-top: 4pt;
      font-weight: 500;
    }
  </style>
</head>
<body class="rr-resume">

  <header class="masthead">
    <div class="name">{{personal.firstName}} {{personal.lastName}}</div>
    {{#if personal.headline}}<div class="headline">{{personal.headline}}</div>{{/if}}
    <div class="contact">
      {{#if personal.email}}<span>{{personal.email}}</span>{{/if}}
      {{#if personal.phone}}<span>{{personal.phone}}</span>{{/if}}
      {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
      {{#if personal.linkedin}}<span><a href="{{hrefUrl personal.linkedin}}">LinkedIn</a></span>{{/if}}
      {{#if personal.portfolioUrl}}<span><a href="{{hrefUrl personal.portfolioUrl}}">Portfolio</a></span>{{/if}}
      {{#if personal.github}}<span><a href="{{hrefUrl personal.github}}">GitHub</a></span>{{/if}}
    </div>
  </header>

  {{#each sectionOrder}}
    {{#if (eq this "summary")}}
      {{#if @root.personal.summary}}
      <section class="section">
        <div class="section-title">Executive summary</div>
        <div class="summary" data-rr-field="personal.summary">{{{fmt @root.personal.summary}}}</div>
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "experience")}}
      {{#if @root.experiences.length}}
      <section class="section" data-rr-field="section.experience">
        <div class="section-title">Professional experience</div>
        {{#each @root.experiences}}
        <div class="entry">
          <div class="entry-head">
            <div>
              <div class="entry-title">{{title}}{{#if company}} — {{company}}{{/if}}</div>
              {{#if role}}<div class="entry-sub">{{role}}</div>{{/if}}
            </div>
            <div class="entry-date">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
            </div>
          </div>
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "education")}}
      {{#if @root.educations.length}}
      <section class="section" data-rr-field="section.education">
        <div class="section-title">Education</div>
        {{#each @root.educations}}
        <div class="entry">
          <div class="entry-head">
            <div>
              <div class="entry-title">{{degree}}{{#if major}} in {{major}}{{/if}}</div>
              <div class="entry-sub">{{institution}}{{#if gpa}} · GPA {{gpa}}{{/if}}</div>
            </div>
            <div class="entry-date">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
            </div>
          </div>
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "projects")}}
      {{#if @root.projects.length}}
      <section class="section" data-rr-field="section.projects">
        <div class="section-title">Key projects</div>
        {{#each @root.projects}}
        <div class="entry">
          <div class="entry-head">
            <div class="entry-title">
              {{title}}
              {{#if link}}<span style="font-weight:500;font-size:9pt;"> · <a href="{{link}}">Link</a></span>{{/if}}
            </div>
            <div class="entry-date">
              {{#if startDate}}{{formatDate startDate}}{{/if}}
              {{#if isCurrent}} – Present{{else}}{{#if endDate}} – {{formatDate endDate}}{{/if}}{{/if}}
            </div>
          </div>
          {{#if role}}<div class="entry-sub">{{role}}</div>{{/if}}
          {{#if techStack.length}}<div class="tech">{{#each techStack}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</div>{{/if}}
          {{#if bullets.length}}
          <ul class="bullets">
            {{#each bullets}}<li>{{{fmt this}}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </section>
      {{/if}}
    {{/if}}
    {{#if (eq this "skills")}}
      {{#if @root.skills.length}}
      <section class="section" data-rr-field="section.skills">
        <div class="section-title">Core competencies</div>
        <div class="skills-grid">
          {{#each @root.skills}}
          <div class="skill-block">
            <strong>{{{fmt name}}}</strong>
            <span>{{#each skills}}{{{fmt this}}}{{#unless @last}}, {{/unless}}{{/each}}</span>
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}
    {{/if}}
  {{/each}}

</body>
</html>
