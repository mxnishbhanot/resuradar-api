<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{personal.firstName}} {{personal.lastName}} - Resume</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Calibri', 'Arial', sans-serif;
      font-size: 10pt;
      line-height: 1.4;
      color: #000;
      background: #fff;
      padding: 0.4in 0.5in;
    }

    .header {
      text-align: center;
      margin-bottom: 12pt;
      border-bottom: 1.5pt solid #000;
      padding-bottom: 8pt;
    }

    .header h1 {
      font-size: 18pt;
      font-weight: bold;
      margin-bottom: 2pt;
      text-transform: uppercase;
      letter-spacing: 0.5pt;
    }

    .header .headline {
      font-size: 11pt;
      color: #333;
      margin-bottom: 4pt;
    }

    .header .contact {
      font-size: 9pt;
      color: #444;
    }

    .header .contact span {
      display: inline-block;
      margin: 0 6pt;
    }

    .header .contact span:first-child {
      margin-left: 0;
    }

    .section {
      margin-bottom: 10pt;
    }

    .section-title {
      font-size: 11pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.5pt;
      border-bottom: 1pt solid #333;
      padding-bottom: 2pt;
      margin-bottom: 6pt;
    }

    .summary {
      font-size: 10pt;
      line-height: 1.35;
      text-align: justify;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 4pt 12pt;
    }

    .skill-category {
      font-size: 9.5pt;
    }

    .skill-category strong {
      font-weight: bold;
    }

    .skill-category span {
      font-weight: normal;
    }

    .entry {
      margin-bottom: 8pt;
      page-break-inside: avoid;
    }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 2pt;
    }

    .entry-title {
      font-size: 10.5pt;
      font-weight: bold;
    }

    .entry-subtitle {
      font-size: 10pt;
      font-style: italic;
      color: #222;
    }

    .entry-date {
      font-size: 9pt;
      color: #555;
      white-space: nowrap;
    }

    .entry-bullets {
      margin-left: 14pt;
      margin-top: 3pt;
    }

    .entry-bullets li {
      font-size: 9.5pt;
      line-height: 1.35;
      margin-bottom: 2pt;
    }

    .tech-stack {
      font-size: 9pt;
      color: #444;
      margin-top: 2pt;
      font-style: italic;
    }

    .tech-stack strong {
      font-weight: bold;
      font-style: normal;
    }

    @media print {
      body {
        padding: 0;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <div class="header">
    <h1>{{personal.firstName}} {{personal.lastName}}</h1>
    {{#if personal.headline}}
      <div class="headline">{{personal.headline}}</div>
    {{/if}}
    <div class="contact">
      {{#if personal.email}}<span>{{personal.email}}</span>{{/if}}
      {{#if personal.phone}}<span>{{personal.phone}}</span>{{/if}}
      {{#if personal.location}}<span>{{personal.location}}</span>{{/if}}
    </div>
  </div>

  <!-- Summary -->
  {{#if personal.summary}}
  <div class="section">
    <div class="section-title">Professional Summary</div>
    <div class="summary">{{personal.summary}}</div>
  </div>
  {{/if}}

  <!-- Skills -->
  {{#if skills.length}}
  <div class="section">
    <div class="section-title">Technical Skills</div>
    <div class="skills-grid">
      {{#each skills}}
        <div class="skill-category">
          <strong>{{name}}:</strong> <span>{{#each skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
        </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <!-- Work Experience -->
  {{#if experiences.length}}
  <div class="section">
    <div class="section-title">Professional Experience</div>
    {{#each experiences}}
      <div class="entry">
        <div class="entry-header">
          <div>
            <div class="entry-title">{{title}}{{#if company}} – {{company}}{{/if}}</div>
            {{#if role}}
              <div class="entry-subtitle">{{role}}</div>
            {{/if}}
          </div>
          <div class="entry-date">
            {{#if startDate}}{{formatDate startDate "MMM YYYY"}}{{/if}}
            {{#if isCurrent}}
              – Present
            {{else}}
              {{#if endDate}} – {{formatDate endDate "MMM YYYY"}}{{/if}}
            {{/if}}
          </div>
        </div>
        {{#if bullets.length}}
          <ul class="entry-bullets">
            {{#each bullets}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}
      </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- Education -->
  {{#if educations.length}}
  <div class="section">
    <div class="section-title">Education</div>
    {{#each educations}}
      <div class="entry">
        <div class="entry-header">
          <div>
            <div class="entry-title">{{degree}} in {{major}}</div>
            <div class="entry-subtitle">{{institution}}{{#if gpa}} – GPA: {{gpa}}{{/if}}</div>
          </div>
          <div class="entry-date">
            {{#if startDate}}{{formatDate startDate "MMM YYYY"}}{{/if}}
            {{#if isCurrent}}
              – Present
            {{else}}
              {{#if endDate}} – {{formatDate endDate "MMM YYYY"}}{{/if}}
            {{/if}}
          </div>
        </div>
        {{#if bullets.length}}
          <ul class="entry-bullets">
            {{#each bullets}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}
      </div>
    {{/each}}
  </div>
  {{/if}}

  <!-- Projects -->
  {{#if projects.length}}
  <div class="section">
    <div class="section-title">Projects</div>
    {{#each projects}}
      <div class="entry">
        <div class="entry-header">
          <div>
            <div class="entry-title">{{title}}{{#if role}} – {{role}}{{/if}}</div>
          </div>
          <div class="entry-date">
            {{#if startDate}}{{formatDate startDate "MMM YYYY"}}{{/if}}
            {{#if isCurrent}}
              – Present
            {{else}}
              {{#if endDate}} – {{formatDate endDate "MMM YYYY"}}{{/if}}
            {{/if}}
          </div>
        </div>
        {{#if techStack.length}}
          <div class="tech-stack">
            <strong>Tech Stack:</strong> {{#each techStack}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
          </div>
        {{/if}}
        {{#if bullets.length}}
          <ul class="entry-bullets">
            {{#each bullets}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}
      </div>
    {{/each}}
  </div>
  {{/if}}

</body>
</html>